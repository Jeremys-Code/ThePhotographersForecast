<?xml version="1.0" encoding="UTF-8" ?>
    <Shell
    x:Class="ThePhotographersForecast.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ThePhotographersForecast"
    xmlns:views="clr-namespace:ThePhotographersForecast.Views"
    FlyoutBehavior="Disabled"
    Title="The Photographer's Forecast">
    <TabBar>
        <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:SelectLocation}"
        Route="SelectLocation" />
        <ShellContent
            Title="PhotoTimeTrack"
            ContentTemplate="{DataTemplate views:PhotoTimeTrack}"
            Route="PhotoTimeTrack" />
        <ShellContent
     Title="Forecast"
     ContentTemplate="{DataTemplate views:Forecast}"
     Route="Forecast" />
        <ShellContent
                Title="Calendar"
                ContentTemplate="{DataTemplate views:Calendar}"
                Route="Calendar"/>
    </TabBar>
</Shell>
