<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThePhotographersForecast.AppShell"
    xmlns:local="clr-namespace:ThePhotographersForecast"
    xmlns:views="clr-namespace:ThePhotographersForecast.Views"
    FlyoutBehavior="Disabled"
    Title="The Photographer's Forecast">
    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate views:SelectLocation}"/>
        <ShellContent Title="Forecast" ContentTemplate="{DataTemplate views:Forecast}" />
        <ShellContent Title="Preferences" ContentTemplate="{DataTemplate views:Settings}" />
    </TabBar>
</Shell>
