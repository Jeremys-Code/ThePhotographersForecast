<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ThePhotographersForecast.AppShell"
    xmlns:local="clr-namespace:ThePhotographersForecast"
    xmlns:views="clr-namespace:ThePhotographersForecast.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    FlyoutBehavior="Disabled"
    Title="The Photographer's Forecast">
    <TabBar>
        <ShellContent Title="Select Location" Route="SelectLocation" ContentTemplate="{DataTemplate views:SelectLocation}"/>
        <ShellContent Title="Forecast" Route="Forecast" ContentTemplate="{DataTemplate views:Forecast}" />
        <ShellContent Title="Forecast Details" Route="ForecastDetails" ContentTemplate="{DataTemplate views:ForecastDetails}"/>
        <ShellContent Title="Calendar" Route="Calendar" ContentTemplate="{DataTemplate views:Calendar}" />
        <ShellContent Title="Event Planner" Route="EventPlanner" ContentTemplate="{DataTemplate views:EventPlanner}"/>
        <ShellContent Title="DataCheck" Route="DataCheck" ContentTemplate="{DataTemplate views:DataCheck}"/>
        <ShellContent Title="Preferences" Route="Settings" ContentTemplate="{DataTemplate views:Settings}" />
    </TabBar>
</Shell>
