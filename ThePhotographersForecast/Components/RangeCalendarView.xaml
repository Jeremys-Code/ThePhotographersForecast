<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ThePhotographersForecast.Components"
             x:Class="ThePhotographersForecast.Components.RangeCalendarView"
             x:Name="ThisControl">

    <Border Stroke="{StaticResource NoonReverse}"
            StrokeThickness="4"
            Background="#2A2C30"
            HorizontalOptions="Fill">
        <!--MaximumWidthRequest="380"-->
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="5">
            <!-- Header: Month and Year Range -->
            <Label Text="{Binding MonthRangeText, Source={x:Reference ThisControl}}"
                   FontFamily="NotoThick"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,2"/>

            <!-- Days of Week Header -->
            <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,2,0,2">
                <Label Grid.Column="0" Text="Sun" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="1" Text="Mon" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="2" Text="Tue" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="3" Text="Wed" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="4" Text="Thu" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="5" Text="Fri" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                <Label Grid.Column="6" Text="Sat" FontFamily="NotoSans" FontSize="11" HorizontalTextAlignment="Center" FontAttributes="Bold"/>
            </Grid>

            <!-- Calendar Days Grid Container -->
            <CollectionView ItemsSource="{Binding CalendarDays, Source={x:Reference ThisControl}}"
                            SelectionMode="None">
                            <!--HeightRequest="240"-->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="7"
                                     HorizontalItemSpacing="1"
                                     VerticalItemSpacing="2"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:CalendarDayModel">
                        <Border HeightRequest="20"
                                WidthRequest="20"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1.5"
                                Padding="3">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="3"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThisControl}, Path=DayTappedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Label Text="{Binding DayText}"
                                   FontFamily="NotoSans"
                                   FontSize="9"
                                   TextColor="{Binding TextColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Status / Legend -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,4,0,0">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Border HeightRequest="12" WidthRequest="12" BackgroundColor="#BEFCA6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3"/>
                        </Border.StrokeShape>
                    </Border>
                    <Label Text="Selected" FontSize="10" TextColor="#A0A5AE" FontFamily="NotoSans"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Border HeightRequest="12" WidthRequest="12" BackgroundColor="{StaticResource GlowInDarkClick}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3"/>
                        </Border.StrokeShape>
                    </Border>
                    <Label Text="In Range" FontSize="10" TextColor="#A0A5AE" FontFamily="NotoSans"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>

