    <ContentPage 
        xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        x:Class="ThePhotographersForecast.Views.TimeLine"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:m="clr-namespace:ThePhotographersForecast.Models"
             x:DataType="vm:TimeLineViewModel"
             Title="TimeLine">
    <ContentPage.BindingContext>
        <vm:TimeLineViewModel/>
    </ContentPage.BindingContext>
    <Grid>
        <Border Background="{AppThemeBinding Light={StaticResource DayTwilight}, Dark={StaticResource MidnightBlue}}" Stroke="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" StrokeShape="RoundRectangle 12" Margin="20" Padding="20">
            <StackLayout HorizontalOptions="Center">
                <Label x:Name="NameLabel" Text="The Photographer's Forecast" Margin="4,0,4,0"   FontFamily="ManFont" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                <Image Source="initials.png" WidthRequest="75" HeightRequest="75" HorizontalOptions="Center"/>
                            <!--<Line StrokeThickness="2"  StrokeLineCap="Round" HorizontalOptions="Center" X2="200" Stroke="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" Margin="0,8,0,8"/>-->
                <Label Text="{Binding SelectedLocation.DisplayName}"   Margin="0,0,0,8" HorizontalTextAlignment="Center" FontFamily="Jost" LineBreakMode="WordWrap"/>
                <Label Text="Current Time" FontFamily="ManFont"   HorizontalTextAlignment="Center" Margin="0,8,0,0"/>
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center">
                    <Grid Margin="4,0,4,0">
                        <Label Text="{Binding LocationTime}"   FontFamily="NotoSans"/>
                    </Grid>
                </FlexLayout>
            </StackLayout>
        </Border>
        <Border x:Name="ForecastBorder" Style="{StaticResource ContentBorder}">
            <CarouselView x:Name="PhotoTimeSchedule"
                      ItemsSource="{Binding PhotoSchedules}" 
                      CurrentItem="{Binding SelectedSchedule}">
                           <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="m:Daily">
                        <StackLayout Orientation="Vertical">
                            <Border Stroke="{AppThemeBinding Dark={StaticResource White},Light={StaticResource Black}}" StrokeShape="RoundRectangle 12" Margin="20" Padding="20">
                            
                    <VerticalStackLayout WidthRequest="250">
                                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,8">
                                        <Label x:Name="StartTimeLabel" Text="{Binding StartTime, StringFormat='{0:h tt}' }" HorizontalOptions="Center"  FontFamily="ManFont"/>
                                        <Label x:Name="EndTimeLabel" Text="{Binding EndTime, StringFormat='{0:h tt}' }" HorizontalOptions="Center"  FontFamily="ManFont"/>
                                    </HorizontalStackLayout>
                                    <Label x:Name="ItemTitle" Text="{Binding Name}"  HorizontalTextAlignment="Center" HorizontalOptions="Center" FontAttributes="Italic" FontFamily="Jost" />
                                    <Image Source="{Binding DailyImageSource}" Aspect="AspectFill" WidthRequest="50" Margin="10"/>
                                    <Label Text="{Binding DailyTemperature}" FontFamily="Jost" HorizontalTextAlignment="Start" LineBreakMode="WordWrap"/>
                                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,8,0,0">
                                        <Label Text="{Binding DailyHigh}" HorizontalOptions="Center" FontFamily="Jost"/>
                                        <Label Text="{Binding DailyLow}" HorizontalOptions="Center" FontFamily="Jost"/>
                                    </HorizontalStackLayout>
                                    <Label x:Name="Summary" Text="{Binding DailyForecast}" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </StackLayout>
                    </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        </Border>
    </Grid>
</ContentPage>