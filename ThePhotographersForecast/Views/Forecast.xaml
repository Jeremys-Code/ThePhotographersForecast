<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models" 
             xmlns:jt="clr-namespace:ThePhotographersForecast.Components"
             x:Class="ThePhotographersForecast.Views.Forecast"
             x:DataType="vm:ForecastViewModel"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             xmlns:shared="clr-namespace:ThePhotographersForecast.Shared"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             Title="Photographers Forecast">
    <ScrollView>
    <VerticalStackLayout Padding="20">
        <Border Stroke="{StaticResource GpsCircleBorder}" StrokeThickness="10" Background="{StaticResource GpsBackground}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Fill">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="The Photographer's forecast for:" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" HorizontalOptions="Fill" FontFamily="ManFont" FontSize="32" />
                        <Label Text="{Binding LocationName}"  HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" FontFamily="ManFont" FontSize="30" />
                        <Label Text="{Binding LocationTime}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,8"  FontFamily="NotoSans" FontSize="18"/>
                    </VerticalStackLayout>




                    <!--Header Ends-->
                    <BoxView HeightRequest="10" HorizontalOptions="Fill" Color="Transparent"/>
                    <!--Calendar Dates Menu-->
                    <!--<VerticalStackLayout HorizontalOptions="Center">
                            <HorizontalStackLayout VerticalOptions="Start">-->


                    <VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalOptions="Fill">
                            <CollectionView x:Name="CalendarDatePicker" Grid.Column="0"  ItemsSource="{Binding Dates}"
                           SelectedItem="{Binding SelectedDate}"
                SelectionChangedCommand="{Binding OnSelectedDateCommand}"
                SelectionChangedCommandParameter="{Binding .}"
                        WidthRequest="250"
                        HorizontalOptions="Start"
                        SelectionMode="Single">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                             Span="4" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:DateItem">
                                        <Border Margin="8"
                            Stroke="Green" 
                            StrokeThickness="2" 
                            HeightRequest="50" 
                            WidthRequest="50" 
                                 Style="{StaticResource ActiveLink}">
                                            <Label Text="{Binding DateDisplay}"
                                   FontFamily="NotoSans"
                                   FontSize="12" 
                                   Margin="2" 
                                   TextColor="Black"
                                   LineBreakMode="WordWrap" 
                                   VerticalTextAlignment="Center" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>


                            <Border Grid.Column="1" Stroke="{StaticResource PeriodEarlyMorning}" StrokeThickness="4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label VerticalOptions="Start" VerticalTextAlignment="Start" x:Name="SunMoonSummaryLabel" Text="Sun and Moon Summary:" FontFamily="ManFont" FontSize="18" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="4,4,5,4"/>
                                    <HorizontalStackLayout Margin="4" VerticalOptions="Start" HorizontalOptions="Start">
                                        <Label Text="Day Length:" FontFamily="NotoSans" VerticalOptions="Start" VerticalTextAlignment="Start" HorizontalOptions="Start" HorizontalTextAlignment="Start" FontSize="14"/>
                                        <Label Text="{Binding SelectedDayLength}" FontSize="14" VerticalOptions="Start" VerticalTextAlignment="Start" HorizontalOptions="Start" HorizontalTextAlignment="Start" FontFamily="NotoSans"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Margin="4" HorizontalOptions="Start" VerticalOptions="Start">
                                        <Label Text="Sunshine Length:" FontSize="14" FontFamily="NotoSans" VerticalOptions="Start" VerticalTextAlignment="Start" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                                        <Label  Text="{Binding SelectedSunshine}" FontSize="14" FontFamily="NotoSans" VerticalOptions="Start" VerticalTextAlignment="Start" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Margin="4" HorizontalOptions="Start">
                                        <Label Text="Current Moon Phase:" FontFamily="NotoSans" FontSize="14" VerticalOptions="Center" VerticalTextAlignment="Center" HorizontalOptions="Start" LineBreakMode="WordWrap" HorizontalTextAlignment="Start"/>
                                        <Label Text="{Binding SelectedMoonPhase}" FontSize="14" FontFamily="NotoSans" FontAttributes="Bold" VerticalOptions="Center" VerticalTextAlignment="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                                    </HorizontalStackLayout>
                                    <skia:SKLottieView Source="{Binding SelectedMoonPhase}" Grid.Row="2" Grid.Column="1" HorizontalOptions="Center" x:Name="SkMoonPhase" RepeatCount="-1" RepeatMode="Restart"  HeightRequest="100" WidthRequest="100" Margin="5,10"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Moon Phases Carousel -->

                            <jt:MoonPhasesCarouselView Grid.Column="2"/>
                        </Grid>
                    </VerticalStackLayout>






                    <CollectionView ItemsSource="{Binding SelectedDay.Periods}"
                                                     SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="6"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:DayPeriod">
                                <Grid ColumnSpacing="2" HorizontalOptions="Center" >
                                    <Border Margin="6" Background="{Binding TimeOfDayBackgroundBrush}">
                                        <Border.StrokeShape>
                                            <RoundRectangle  CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding TimeOfDayName}" TextColor="#FFFF00" FontAttributes="Bold"  FontFamily="ManFont" FontAutoScalingEnabled="True"  TextDecorations="Underline" HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="5" />
                                                <skia:SKLottieView x:Name="TimeOfDayAnimation" Source="{Binding TimeOfDayImage}" RepeatCount="-1" RepeatMode="Restart" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center"/>
                                                <Label Text="The forecast for" TextColor="#FFFF00" FontFamily="ManFont" FontAutoScalingEnabled="True" TextDecorations="Underline" FontAttributes="Bold" HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="5" />
                                                <Label Text="{Binding HourlyName}" TextColor="#FFFF00" FontFamily="ManFont" FontAutoScalingEnabled="True"  FontAttributes="Bold" TextDecorations="Underline" HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="5" />
                                                <skia:SKLottieView x:Name="TimeOfDaySkWeatherMeteocon" HeightRequest="80" WidthRequest="80" RepeatCount="-1" RepeatMode="Restart" Source="{Binding TimeOfDayWeatherImage}" HorizontalOptions="Center" Margin="5"/>
                                                <Label Text="{Binding TimeOfDayStormSummary}" TextColor="#FF004D" Shadow="1,1,2,White,0.9" FontAutoScalingEnabled="True"  FontFamily="NotoSans" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding TimeOfDaySummary}" LineBreakMode="WordWrap" MaxLines="5" FontAutoScalingEnabled="True" FontFamily="NotoSans" TextColor="#FE0194" HorizontalOptions="Center" Margin="5" />
                                                <CollectionView ItemsSource="{Binding TimeOfDayEvents}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:EventTime">
                                                            <VerticalStackLayout Margin="5">
                                                                <Label Text="{Binding EventName}" LineBreakMode="WordWrap" FontFamily="ManFont" FontAttributes="Bold" TextColor="#26f629" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                                                <HorizontalStackLayout HorizontalOptions="Center">
                                                                    <Label Text="{Binding TimeLabel}"  HorizontalOptions="Fill" HorizontalTextAlignment="Justify" FontAttributes="Bold" FontAutoScalingEnabled="True" TextColor="#FF01FB" FontFamily="ManFont" />
                                                                    <Label Text="{Binding AstroTime, StringFormat='{}{0:h:mm tt}'}" TextColor="#FAFF00" HorizontalOptions="Fill" HorizontalTextAlignment="Justify" FontAutoScalingEnabled="True" FontAttributes="Bold" FontFamily="ManFont" />
                                                                </HorizontalStackLayout>
                                                                <HorizontalStackLayout HorizontalOptions="Center">
                                                                    <Label Text="{Binding OtherTimeLabel}" TextColor="#00F556" FontFamily="ManFont" HorizontalOptions="Fill" HorizontalTextAlignment="Justify" FontAttributes="Bold" FontAutoScalingEnabled="True"/>
                                                                    <Label Text="{Binding OtherTime, StringFormat='{}{0:h:mm tt}'}" TextColor="#EE1717" FontFamily="ManFont" HorizontalOptions="Fill" FontAttributes="Bold" HorizontalTextAlignment="Justify" FontAutoScalingEnabled="True"/>
                                                                </HorizontalStackLayout>
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>



