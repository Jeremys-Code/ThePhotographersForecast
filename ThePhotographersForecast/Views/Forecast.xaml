<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:foldable="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:service="clr-namespace:ThePhotographersForecast.Services"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             x:Class="ThePhotographersForecast.Views.Forecast"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models"
             xmlns:cv="clr-namespace:ThePhotographersForecast.ContentViews"
             x:DataType="vm:ForecastViewModel"
             BackgroundImageSource="backbay.jpg">
    <ScrollView>
        <Grid Padding="20">

            <!-- Background Rounded Rectangle -->
            <Frame
                CornerRadius="88"
                HasShadow="False"
                Padding="0"
                BackgroundColor="Transparent"
                Grid.RowSpan="10">

                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#66B2FF" Offset="0.0" />
                        <GradientStop Color="#002958" Offset="1.0" />
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <VerticalStackLayout Spacing="18">

                <!-- Title -->
                <Label Text="The Photographer's Forecast"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <!-- Subtitle -->
                <Label Text="for Boston, Massachusetts, United States"
                       FontSize="16"
                       HorizontalOptions="Center" />

                <!-- Location Current Time -->
                <Label Text="{Binding CurrentLocalTime}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <!-- Select Your Date -->
                <Label Text="Select your date:"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,10,0,0" />

                <!-- Date Grid (3 rows × 4 columns) -->
                <Grid ColumnDefinitions="*,*,*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="10">

                    <CollectionView ItemsSource="{Binding AvailableDates}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedDate}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="4" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="6"
                                       Padding="6"
                                       HasShadow="True"
                                       BorderColor="Black"
                                       BackgroundColor="#FFCCE6">
                                    <Label Text="{Binding Display}"
                                           FontSize="12"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="#001933" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>

                <!-- Weather Summary -->
                <VerticalStackLayout Spacing="6" Margin="0,20,0,0">
                    <Label Text="Weather Summary:"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="{Binding WeatherSummary}"
                           FontSize="14"
                           TextColor="White"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- High / Low Temperature -->
                <Grid ColumnDefinitions="*,*"
                      Margin="0,20,0,0">

                    <Frame CornerRadius="6"
                           BorderColor="Blue"
                           BackgroundColor="#99CCFF"
                           Padding="10">
                        <VerticalStackLayout>
                            <Label Text="High" FontAttributes="Bold" />
                            <Label Text="{Binding HighTemp}" />
                            <Label Text="{Binding HighTempTime}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame CornerRadius="6"
                           BorderColor="Red"
                           BackgroundColor="#FF9999"
                           Padding="10"
                           Grid.Column="1">
                        <VerticalStackLayout>
                            <Label Text="Low" FontAttributes="Bold" />
                            <Label Text="{Binding LowTemp}" />
                            <Label Text="{Binding LowTempTime}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Gradient Bar -->
                <BoxView HeightRequest="40" Margin="0,30,0,0">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6A00FF" Offset="0.0" />
                            <GradientStop Color="#FFFF33" Offset="0.33" />
                            <GradientStop Color="#FF99FF" Offset="0.66" />
                            <GradientStop Color="#3399FF" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
