<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models"
             xmlns:ml="clr-namespace:ThePhotographersForecast.Services.ML"
             xmlns:component="clr-namespace:ThePhotographersForecast.Components"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="ThePhotographersForecast.Views.Forecast"
             x:DataType="vm:ForecastViewModel"
             Title="The Photographer's Forecast"
             BackgroundColor="#121824">

    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Padding="15,20,15,30">

            <!-- 1.) RoundRectangle border 8 thick, with EarlyMorning background gradient and depth shadow -->
            <Border Stroke="White"
                    StrokeThickness="8"
                    Background="{StaticResource EarlyMorning}"
                    HeightRequest="350"
                    VerticalOptions="Start"
                    Padding="28,24,28,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,18" Radius="30" Opacity="0.85"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">

                    <!-- Header Section -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <!-- 2.) Static text with font family of NotoThick Bold -->
                        <Label Text="The Photographer's Forecast"
                               FontFamily="HennyPenny"
                               FontSize="30"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- 3.) _session.SelectedLocation.DisplayName -->
                        <Label Text="{Binding LocationName}"
                               FontFamily="NotoSans"
                               FontSize="16"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- 4.) Location Current Time on a 1-second timer -->
                        <Label Text="{Binding LocationTime}"
                               FontFamily="NotoSans"
                               FontSize="14"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,2,0,6"/>
                    </VerticalStackLayout>

                    <!-- Middle Section: Date Selector (Left) + Two-column, Three-row Summary Grid (Right) -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="28">

                        <!-- 5.) Select your date section -->
                        <VerticalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Border Stroke="#D0D7DE"
                                        StrokeThickness="1"
                                        BackgroundColor="White"
                                        WidthRequest="16"
                                        HeightRequest="16"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="2"/>
                                    </Border.StrokeShape>
                                    <BoxView HeightRequest="2" WidthRequest="8" Color="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Select your date:"
                                       FontFamily="NotoThick"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="White"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- 3-Column Grid of Date Cards -->
                            <CollectionView ItemsSource="{Binding Dates}"
                                            SelectedItem="{Binding SelectedCalendarDay}"
                                            SelectionMode="Single"
                                            SelectionChangedCommand="{Binding SelectDateCommand}"
                                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}"
                                            WidthRequest="235">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="component:CalendarDayModel">
                                        <Border Stroke="#D0D7DE"
                                                StrokeThickness="1"
                                                BackgroundColor="White"
                                                HeightRequest="56"
                                                WidthRequest="68"
                                                Padding="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ForecastViewModel}}, Path=SelectDateCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Date, StringFormat='{0:ddd,}'}"
                                                       FontFamily="NotoSans"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Center"/>
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d}'}"
                                                       FontFamily="NotoSans"
                                                       FontSize="12"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- 6.) Two column grid with three rows -->
                        <Grid Grid.Column="1"
                              ColumnDefinitions="*, *"
                              RowDefinitions="Auto, Auto, Auto"
                              RowSpacing="14"
                              ColumnSpacing="22"
                              VerticalOptions="Start">

                            <!-- Row 0: Spans both columns: Daily Summary for {SelectedDate} -->
                            <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,4">
                                <Border Stroke="#D0D7DE"
                                        StrokeThickness="1"
                                        BackgroundColor="White"
                                        WidthRequest="16"
                                        HeightRequest="16"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="2"/>
                                    </Border.StrokeShape>
                                    <BoxView HeightRequest="2" WidthRequest="8" Color="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding DailySummaryTitle}"
                                       FontFamily="NotoThick"
                                       FontSize="23"
                                       TextColor="White"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- 7.) Row 1, Column 0: 2-column grid. Column 0 has 2 rows (High, Low), Column 1 has Daily Lottie -->
                            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto, Auto" ColumnSpacing="14" VerticalOptions="Start">
                                <!-- High and Low -->
                                <Grid Grid.Column="0" RowDefinitions="Auto, Auto" RowSpacing="10" VerticalOptions="Center">
                                    <!-- High Box -->
                                    <Border Grid.Row="0"
                                            Stroke="Red"
                                            StrokeThickness="2"
                                            BackgroundColor="#70FF0000"
                                            MinimumHeightRequest="56"
                                            WidthRequest="140"
                                            Padding="6,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="High"
                                                   FontFamily="NotoThick"
                                                   FontSize="24"
                                                   TextColor="#CCFF7777"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"/>
                                            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding SelectedHighTime}"
                                                       FontFamily="NotoSans"
                                                       FontSize="11"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="End"/>
                                                <Label Text="{Binding SelectedHighTemp}"
                                                       FontFamily="NotoThick"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       LineBreakMode="WordWrap"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- Low Box -->
                                    <Border Grid.Row="1"
                                            Stroke="Blue"
                                            StrokeThickness="2"
                                            BackgroundColor="#700000FF"
                                            MinimumHeightRequest="56"
                                            WidthRequest="140"
                                            Padding="6,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="LOW"
                                                   FontFamily="NotoThick"
                                                   FontSize="24"
                                                   TextColor="#CC99C0FF"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center"/>
                                            <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding SelectedLowTemp}"
                                                       FontFamily="NotoThick"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       LineBreakMode="WordWrap"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Start"/>
                                                <Label Text="{Binding SelectedLowTime}"
                                                       FontFamily="NotoSans"
                                                       FontSize="11"
                                                       TextColor="Black"
                                                       HorizontalTextAlignment="Start"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Daily Lottie File -->
                                <Border Grid.Column="1"
                                        BackgroundColor="#26C6DA"
                                        HeightRequest="122"
                                        WidthRequest="122"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <skia:SKLottieView Source="{Binding SelectedDailyMeteocon}"
                                                       RepeatCount="-1"
                                                       RepeatMode="Restart"
                                                       HeightRequest="92"
                                                       WidthRequest="92"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                </Border>
                            </Grid>

                            <!-- 8.) Row 1, Column 1: Health & Safety Summary -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" VerticalOptions="Start">
                                <Label Text="Health &amp; Safety Summary:"
                                       FontFamily="NotoThick"
                                       FontSize="20"
                                       TextColor="White"/>
                                <Label Text="{Binding SelectedHealthSafetySummary}"
                                       FontFamily="NotoSans"
                                       FontSize="13"
                                       TextColor="White"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- 9.) Row 2, Column 0: Weather Summary -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6" VerticalOptions="Start">
                                <Label Text="Weather Summary:"
                                       FontFamily="NotoThick"
                                       FontSize="20"
                                       TextColor="White"/>
                                <Label Text="{Binding SelectedWeatherSummary}"
                                       FontFamily="NotoSans"
                                       FontSize="13"
                                       TextColor="White"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- 10.) Row 2, Column 1: Sun & Moon Summary -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6" VerticalOptions="Start">
                                <Label Text="Sun &amp; Moon Summary:"
                                       FontFamily="NotoThick"
                                       FontSize="20"
                                       TextColor="White"/>
                                <Label Text="{Binding SelectedDayLength, StringFormat='Day Length: {0}'}"
                                       FontFamily="NotoSans"
                                       FontSize="14"
                                       TextColor="White"/>
                                <Label Text="{Binding SelectedNightLength, StringFormat='Night Length: {0}'}"
                                       FontFamily="NotoSans"
                                       FontSize="14"
                                       TextColor="White"/>
                                <Label Text="{Binding SelectedMoonPhase, StringFormat='Moon Phase: {0}'}"
                                       FontFamily="NotoSans"
                                       FontSize="14"
                                       TextColor="White"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>

                    <!-- 11.) 5 boxes with colorful background gradient -->
                    <CollectionView ItemsSource="{Binding SelectedDayEventsByPeriod}"
                                    SelectionMode="None"
                                    Margin="0,8,0,0">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Horizontal" Span="5" HorizontalItemSpacing="5" VerticalItemSpacing="0"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:DayPeriod">
                                <Border Background="{Binding TimeOfDayBackgroundBrush}"
                                        Padding="10,8"
                                        Stroke="Transparent"
                                        StrokeThickness="0">
                                    <ScrollView VerticalScrollBarVisibility="Never" HeightRequest="400">
                                        <VerticalStackLayout Spacing="6">
                                            <!-- Time of Day Label -->
                                            <Label Text="{Binding TimeOfDayName}"
                                                   FontFamily="NotoThick"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="White"
                                                   HorizontalTextAlignment="Center"/>

                                            <!-- Weather during period -->
                                            <Border BackgroundColor="#45000000" HeightRequest="400" Padding="5,4" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="2" HeightRequest="400">
                                                    <Label Text="{Binding TimeOfDayTemperature}"
                                                           FontFamily="NotoThick"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           TextColor="White"
                                                           HorizontalTextAlignment="Center"/>
                                                    <Label Text="{Binding TimeOfDayForecast}"
                                                           FontFamily="NotoSans"
                                                           FontSize="10"
                                                           TextColor="White"
                                                           LineBreakMode="WordWrap"
                                                           HorizontalTextAlignment="Center"/>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Events during this time of day -->
                                            <Border BackgroundColor="#45000000" Padding="5,4" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="Events:"
                                                           FontFamily="NotoThick"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#FFEB3B"/>
                                                    <StackLayout BindableLayout.ItemsSource="{Binding TimeOfDayEvents}" Spacing="2">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="model:EventTime">
                                                                <VerticalStackLayout Spacing="0">
                                                                    <Label Text="{Binding EventName}"
                                                                           FontFamily="NotoSans"
                                                                           FontAttributes="Bold"
                                                                           FontSize="10"
                                                                           TextColor="White"/>
                                                                    <Label Text="{Binding TimeLabel}"
                                                                           FontFamily="NotoSans"
                                                                           FontSize="9"
                                                                           TextColor="#E0E0E0"/>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </StackLayout>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Photo and Drone Scores and Summary -->
                                            <Border BackgroundColor="#45000000" Padding="5,4" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding PhotoScore}"
                                                           FontFamily="NotoThick"
                                                           FontSize="10"
                                                           TextColor="#BEFCA6"/>
                                                    <Label Text="{Binding DroneScore}"
                                                           FontFamily="NotoThick"
                                                           FontSize="10"
                                                           TextColor="#BEFCA6"/>
                                                    <Label Text="{Binding ScoreSummary}"
                                                           FontFamily="NotoSans"
                                                           FontSize="9"
                                                           TextColor="White"
                                                           LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 12.) Daily AI Photography & Drone Predictions for Selected Date -->
                    <Border Stroke="#45FFFFFF"
                            StrokeThickness="1.5"
                            BackgroundColor="#24000000"
                            Padding="16"
                            Margin="0,12,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="AI Photography &amp; Drone Predictions"
                                   FontFamily="NotoThick"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   TextColor="White"/>

                            <!-- Daily Summary Header -->
                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                <Border BackgroundColor="#353B82F6" Stroke="#60A5FA" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyPhotoScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#BFDBFE"/>
                                </Border>
                                <Border BackgroundColor="#3510B981" Stroke="#34D399" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyDroneScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#A7F3D0"/>
                                </Border>
                                <Border BackgroundColor="#35F59E0B" Stroke="#FBBF24" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyDominantCondition}" FontFamily="NotoThick" FontSize="12" TextColor="#FDE68A"/>
                                </Border>
                                <Border BackgroundColor="#356366F1" Stroke="#818CF8" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyBlueHourScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#C7D2FE"/>
                                </Border>
                                <Border BackgroundColor="#35FB923C" Stroke="#FDBA74" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailySunriseScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#FED7AA"/>
                                </Border>
                                <Border BackgroundColor="#35F43F5E" Stroke="#FB7185" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailySunsetScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#FECDD3"/>
                                </Border>
                                <Border BackgroundColor="#3594A3B8" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyLunarScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#E2E8F0"/>
                                </Border>
                                <Border BackgroundColor="#35A855F7" Stroke="#C084FC" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyGalaxyScoreText}" FontFamily="NotoThick" FontSize="12" TextColor="#E9D5FF"/>
                                </Border>
                                <Border BackgroundColor="#3522C55E" Stroke="LimeGreen" StrokeThickness="1" Padding="10,4" Margin="0,0,10,6"
                                        IsVisible="{Binding HasSelectedDayPredictions}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Label Text="{Binding SelectedDailyBestHoursText}" FontFamily="NotoThick" FontSize="12" TextColor="#BBF7D0"/>
                                </Border>
                            </FlexLayout>

                            <Label Text="{Binding SelectedDailyScoreSummaryText}"
                                   FontFamily="NotoSans"
                                   FontSize="13"
                                   TextColor="#E2E8F0"
                                   LineBreakMode="WordWrap"/>

                            <!-- Hourly Predictions Horizontal Cards -->
                            <CollectionView ItemsSource="{Binding SelectedDayHourlyPredictions}"
                                            SelectionMode="None"
                                            HeightRequest="215"
                                            IsVisible="{Binding HasSelectedDayPredictions}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="ml:HourlyForecastPrediction">
                                        <Border BackgroundColor="#33081F43"
                                                Stroke="#5093C5FD"
                                                StrokeThickness="1.5"
                                                WidthRequest="235"
                                                Padding="10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Timestamp, StringFormat='{0:h:mm tt}'}"
                                                           FontFamily="NotoThick"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="#FDE047"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Condition}"
                                                           FontFamily="NotoSans"
                                                           FontSize="11"
                                                           TextColor="#93C5FD"
                                                           VerticalOptions="Center"/>
                                                </Grid>

                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding OverallScore, StringFormat='Overall: {0:F0}'}" FontFamily="NotoThick" FontSize="11" TextColor="#BEFCA6"/>
                                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding DroneFlightScore, StringFormat='Drone: {0:F0}'}" FontFamily="NotoThick" FontSize="11" TextColor="#A7F3D0"/>
                                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding BlueHourScore, StringFormat='Blue Hr: {0:F0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#93C5FD"/>
                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SunriseScore, StringFormat='Sunrise: {0:F0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#FDBA74"/>
                                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding SunsetScore, StringFormat='Sunset: {0:F0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#F9A8D4"/>
                                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding LunarEventScore, StringFormat='Lunar: {0:F0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#E2E8F0"/>
                                                    <Label Grid.Row="3" Grid.Column="0" Text="{Binding GalaxyScore, StringFormat='Galaxy: {0:F0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#C4B5FD"/>
                                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding ConditionConfidence, StringFormat='Conf: {0:P0}'}" FontFamily="NotoSans" FontSize="11" TextColor="#CBD5E1"/>
                                                </Grid>

                                                <Label Text="{Binding HumanReadableForecast}"
                                                       FontFamily="NotoSans"
                                                       FontSize="10"
                                                       TextColor="#E2E8F0"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="4"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
