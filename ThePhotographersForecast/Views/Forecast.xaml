    <ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models" 
             x:Class="ThePhotographersForecast.Views.Forecast"
             x:DataType="vm:ForecastViewModel"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:cv="clr-namespace:ThePhotographersForecast.ContentViews"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             BackgroundImageSource="backbay.jpg"
             Title="Forecast">
    <ContentPage.Resources>
        <svc:ShortDateDisplayConverter x:Key="ShortDateDisplayConverter"/>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Label Text="Forecast page" HorizontalOptions="Center" VerticalOptions="Center" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dates -->
                <CollectionView ItemsSource="{Binding Session.Dates}"
                            SelectedItem="{Binding SelectedDate}"
                            SelectionMode="Single"
                            HeightRequest="280"
                             Grid.Column="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <FlexLayout AlignContent="SpaceEvenly" AlignItems="Start" Wrap="Wrap" Direction="Row">
                            <Border Margin="6" Stroke="Red" StrokeThickness="2" HeightRequest="40" WidthRequest="40" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                    <Label Text="{Binding ., StringFormat='{}{0:ddd, MMM d}'}"
                                           TextColor="Black" 
                                           FontSize="12" 
                                           Margin="1" 
                                           LineBreakMode="WordWrap" 
                                           VerticalOptions="Center" 
                                           VerticalTextAlignment="Center" 
                                           HorizontalOptions="Center" 
                                           HorizontalTextAlignment="Center" />
                            </Border>
                            </FlexLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid Grid.Column="2">
                    <VerticalStackLayout>
                        <Label x:Name="DailySummary" Text="{Binding TimePeriod}" FontSize="20" HorizontalOptions="Center" HorizontalTextAlignment="Justify" FontFamily="ManFont"/>
                        <HorizontalStackLayout>
                        <VerticalStackLayout WidthRequest="300" Margin="8">
                                <HorizontalStackLayout>
                                    <VerticalStackLayout>
                                        <Grid RowSpacing="20" Margin="20">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="80"/>
                                                <RowDefinition Height="80"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" WidthRequest="120">
                                                <Image Source="hightemp.png" Aspect="AspectFill" HeightRequest="80" WidthRequest="120" ZIndex="0"/>
                                                <HorizontalStackLayout HorizontalOptions="Center" ZIndex="1" Margin="8">
                                                    <Label x:Name="High" Text="{Binding SelectedDailyMaxTemp}" VerticalOptions="Start" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="8"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <Grid Grid.Row="1" WidthRequest="120">
                                                <Image Source="lowtemp.png" Aspect="AspectFill" HeightRequest="80" WidthRequest="120" ZIndex="0"/>
                                                <HorizontalStackLayout ZIndex="1" HorizontalOptions="Center" Margin="8">
                                                    <Label x:Name="Low" Text="{Binding SelectedDailyMinTemp}" HorizontalOptions="Center" HorizontalTextAlignment="Center" VerticalOptions="End" Margin="8"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Border Stroke="{StaticResource GlowInDark}" StrokeThickness="4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                        <Image Source="{Binding SelectedDailyIcon}" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center"  HeightRequest="120" WidthRequest="120"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Label Text="Weather Summary:" FontFamily="ManFont" HorizontalOptions="Start" HorizontalTextAlignment="Start"/>
                                <Label Text="{Binding SelectedDailyWeatherSummary}" LineBreakMode="WordWrap" FontFamily="NotoSans" />
                            </VerticalStackLayout>
                    </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
            <!-- Periods -->
            <CollectionView ItemsSource="{Binding DayPeriods}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="6" Background="{Binding BackgroundBrush}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Center" />
                                <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout>
                                                <Label Text="{Binding EventName}" FontSize="12" />
                                                <Label Text="{Binding AstroTime, StringFormat='{0:h:mm tt}'}" FontSize="10" />
                                            </StackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
