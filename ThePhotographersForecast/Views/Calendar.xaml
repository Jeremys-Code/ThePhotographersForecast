<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ThePhotographersForecast.Views.Calendar"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             Title="Calendar"
             x:DataType="vm:CalendarViewModel">
    <Grid RowDefinitions="Auto, Auto, *" BackgroundColor="{StaticResource OffWhite}">
        <!-- Header: Month/Year and Navigation -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Padding="10">
            <Button Grid.Column="0" Text="&lt; Prev" Command="{Binding PreviousCommand}" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding MonthYear}" FontSize="Large" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Next &gt;" Command="{Binding NextCommand}" HorizontalOptions="End"/>
        </Grid>

        <!-- Days of the Week -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Padding="5,0">
            <Label Grid.Column="0" Text="Sun" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="1" Text="Mon" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="2" Text="Tue" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="3" Text="Wed" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="4" Text="Thu" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="5" Text="Fri" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="6" Text="Sat" Style="{StaticResource DayOfWeekLabelStyle}"/>
        </Grid>

        <!-- Calendar Days -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}"  Margin="5">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:DayViewModel">

                    <Grid IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}"
                          Padding="1"
                          HeightRequest="120">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FlipCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="FlipStates">
                                <VisualState Name="Flipped">
                                    <VisualState.Setters>
                                        <Setter TargetName="CardFront" Property="VisualElement.RotationY" Value="-180" />
                                        <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter TargetName="CardFront" Property="VisualElement.RotationY" Value="0" />
                                        <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="180" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Card Front -->
                        <Border  x:Name="CardFront" Style="{StaticResource InactiveDateStyle}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEventDay}" Value="True">
                                    <Setter Property="Stroke" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEventWindowDay}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Gold}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource HunterGreenBorder}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Day}" Style="{StaticResource DayLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsEventDay}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <!-- Card Back -->
                        <Border x:Name="CardBack" Style="{StaticResource ActiveDateStyle}" RotationY="180">
                            <VerticalStackLayout>
                                <Label x:Name="CardTitle" HorizontalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Photographer's Day for {0} at {1}">
                                            <Binding Path="Date"/>
                                            <Binding Path="SelectedLocation.DisplayName"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Grid x:Name="PhotoDayDetails" ColumnDefinitions="*,*">
                                    <VerticalStackLayout x:Name="LeftSummary" Grid.Column="0">
                                        <CollectionView x:Name="WeatherDescriptionByTimeOfDay"  ItemsSource="{Binding SelectedDayDayWeather.WeatherDetails}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="model:DailyForecast">
                                                    <VerticalStackLayout>
                                                        <Label Text="Weather Forecast Summary:"/>
                                                        <Label x:Name="LocationTime" Text="{Binding WeatherDetail.LocalTime}"/>
                                                        <skia:SKLottieView x:Name="DailyWeatherImage" Source="{Binding SkDailyMeteocon}" RepeatCount="-1" RepeatMode="Restart" />
                                                        <Label x:Name="DailySummary" Text="{Binding DailyForecastSummary.StormSummary}" LineBreakMode="WordWrap"/>
                                                        <Label Text="Health and Safety:"/>
                                                        <Label x:Name="HealthAndSafety" Text="{Binding DailyForecastSummary.HealthSafetySummary}" LineBreakMode="WordWrap"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="RightDetails" Grid.Column="1">
                                        <CarouselView x:Name="EventCarousel" RemainingItemsThreshold="7" ItemsUpdatingScrollMode="KeepItemsInView" CurrentItem="{Binding SelectedDayCurrentEventTime}" ItemsSource="{Binding SelectedDayEventTimes}">
                                            <CarouselView.ItemTemplate>
                                                <DataTemplate x:DataType="model:EventTime">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="auto"/>
                                                            <RowDefinition Height="auto"/>
                                                        </Grid.RowDefinitions>
                                                        <VerticalStackLayout Grid.Row="0" x:Name="EventDisplay">
                                                            <HorizontalStackLayout>
                                                                <Label x:Name="EventNameLabel" Text="Event: " FontSize="18" FontFamily="NotoSans"/>
                                                                <Label x:Name="EventName" Text="{Binding EventName}" FontSize="20" FontFamily="ManFont"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout>
                                                                <Label x:Name="EventTimeLable" Text="Event: " FontSize="18" FontFamily="NotoSans"/>
                                                                <Label x:Name="EventTime" Text="{Binding OrderTime, StringFormat='{}{0:h:mm tt}'}" FontSize="20" FontFamily="NotoSans"/>
                                                            </HorizontalStackLayout>

                                                            <skia:SKLottieView Source="{Binding HourlyForecast.WeatherImage}" RepeatCount="-1" RepeatMode="Restart"/>
                                                            <Label x:Name="SummaryLabel" Text="Summary:" HorizontalTextAlignment="Start"/>
                                                            <Label x:Name="HourlySummary" Text="{Binding HourlyWeather.HourlyForecastSummary.WeatherSummary}" LineBreakMode="WordWrap"/>
                                                            <Label x:Name="HealthSafetyLabel" Text="Outdoors Health and Safety:" HorizontalTextAlignment="Start"/>
                                                            <Label x:Name="SafetySummary" Text="{Binding HourlyWeather.HourlyForecastSummary.HealthSafetySummary}" LineBreakMode="WordWrap"/>
                                                        </VerticalStackLayout>

                                                    </Grid>
                                                </DataTemplate>
                                            </CarouselView.ItemTemplate>
                                        </CarouselView>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Date, StringFormat='{0:d}'}" FontAttributes="Bold"/>
                                    <Label Text="Details will go here..." FontSize="Micro"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

                                                      