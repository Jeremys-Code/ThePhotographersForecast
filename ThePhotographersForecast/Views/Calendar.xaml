<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThePhotographersForecast.Views.Calendar"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             xmlns:m="clr-namespace:ThePhotographersForecast.Models"
             Title="Calendar"
             x:DataType="vm:CalendarViewModel">

    <Grid RowDefinitions="Auto, Auto, *" BackgroundColor="{StaticResource OffWhite}">
        <!-- Header: Month/Year and Navigation -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Padding="10">

            <Button Grid.Column="0" Text="&lt; Prev" Command="{Binding PreviousMonthCommand}" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="{Binding MonthYear}" FontSize="Large" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Next &gt;" Command="{Binding NextMonthCommand}" HorizontalOptions="End"/>
        </Grid>
        <Border Style="{StaticResource ContentBorder}" HorizontalOptions="Center" ZIndex="99" VerticalOptions="Fill" IsVisible="{Binding IsWorking}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding ProgressMessage}" HorizontalTextAlignment="Center" FontAttributes="Bold"  Margin="4,0,4,0"  />
                <Line Stroke="Black" StrokeThickness="12" StrokeLineCap="Round" Margin="10"/>
                <ActivityIndicator x:Name="ProgressIndicator"  
                           Grid.RowSpan="3"
                           Grid.ColumnSpan="3"
           WidthRequest="100" 
           HeightRequest="100" 
           IsEnabled="{Binding IsWorking}"
           IsVisible="{Binding IsWorking}"
           IsRunning="{Binding IsWorking}"
           Style="{StaticResource WaitingSpinner}"
           ZIndex="2"
           VerticalOptions="Fill"
           HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </Border>

        <!-- Days of the Week -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Padding="5,0">
            <Label Grid.Column="0" Text="Sun" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="1" Text="Mon" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="2" Text="Tue" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="3" Text="Wed" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="4" Text="Thu" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="5" Text="Fri" Style="{StaticResource DayOfWeekLabelStyle}"/>
            <Label Grid.Column="6" Text="Sat" Style="{StaticResource DayOfWeekLabelStyle}"/>
        </Grid>

        <!-- Calendar Days  -->
        <!-- TODO: change to use PhotoDayModel -->
        <!-- TODO: Command uses GetPhotoDay -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding PhotographersDaysModel.PhotoDays}" SelectedItem="{Binding SelectedDay}" SelectionChangedCommand="{Binding SelectedPhotoDayChangedCommand}" Margin="5">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout x:Name="CalendarItems">

                        <Grid IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}"
                  Padding="1"
                  HeightRequest="120">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarViewModel}}, Path=FlipCommand}"
                                           CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>



                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="FlipStates">
                                    <VisualState Name="Flipped">
                                        <VisualState.Setters>
                                            <Setter TargetName="CardFront" Property="VisualElement.RotationY" Value="-180" />
                                            <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter TargetName="CardFront" Property="VisualElement.RotationY" Value="0" />
                                            <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="180" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <!-- Card Front -->
                            <Border  x:Name="CardFront" Style="{StaticResource InactiveDateStyle}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEventDay}" Value="True">
                                        <Setter Property="Stroke" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEventWindowDay}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Gold}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource HunterGreenBorder}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <!-- TODO: Card Title should read "TimeOfDay,Weekday, Month name, Day" -->
                                <!-- TODO: Change to use PhotoDay -->
                                <Label Text="{Binding SelectedDayCurrentDaily}" Style="{StaticResource DayLabelStyle}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEventDay}" Value="True">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Card Back -->
                            <Border x:Name="CardBack" Style="{StaticResource ActiveDateStyle}" RotationY="180">
                                <VerticalStackLayout>
                                    <Label x:Name="CardTitle" HorizontalTextAlignment="Center">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Photographer's Day for {0} at {1}">
                                                <Binding Path="LocationTime"/>
                                                <Binding Path="LocationName"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Grid x:Name="PhotoDayDetails">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <VerticalStackLayout x:Name="LeftSummary" Grid.Column="0">
                                            <!-- TODO: Change to use PhotoDayModel.Forecast -->

                                            <!-- TODO: Change to use PhotoDayModel.Forecast -->
                                            <Label Text="Itinerary while at:"/>
                                            <Label x:Name="LocationNameLabel" Text="{Binding LocationName, StringFormat='{}Destination:{0}'}"/>
                                            <FlexLayout Grid.Column="0" Direction="Row" Wrap="Wrap" JustifyContent="Start">
                                                <Label x:Name="CurrentTime" Text="{Binding CurrentTime, StringFormat='{}Your current date and time: {1}'}"/>

                                                <Label x:Name="LocationTime" Text="{Binding LocationTime, StringFormat='{}Your photo location date and time: {2}'}"/>
                                            </FlexLayout>

                                            <CarouselView x:Name="WeatherDescriptionByTimeOfDay" ItemsSource="{Binding SelectedDayDailyForecasts}" CurrentItem="{Binding SelectedDayCurrentDailyForecast}" RemainingItemsThreshold="3">
                                                <CarouselView.ItemTemplate>
                                                    <DataTemplate x:DataType="m:Daily">
                                                        <VerticalStackLayout HorizontalOptions="Center">
                                                            <Label Text="{Binding TimeOfDay}" FontAttributes="Bold"/>
                                                            <Label Text="{Binding Name}" LineBreakMode="WordWrap"/>
                                                            <HorizontalStackLayout Spacing="10">
                                                                <Label Text="Start Time:"/>
                                                                <Label Text="{Binding StartTime, StringFormat='{0:hhtt}'}"/>
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout Spacing="10">
                                                                <Label Text="End Time:"/>
                                                                <Label Text="{Binding EndTime, StringFormat='{0:hhtt}'}"/>
                                                            </HorizontalStackLayout>
                                                            <Label x:Name="HighLowLabel" Text="Temperature high and low:" HorizontalOptions="Center" HorizontalTextAlignment="Justify"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid x:Name="DailyHigh" Padding="4" Grid.Column="0">
                                                                    <Image Source="hightemp.png" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                                        <Label x:Name="HighTemp" Text="{Binding DailyHigh}" FontSize="Caption" FontFamily="Jost" LineBreakMode="WordWrap"/>
                                                                    </VerticalStackLayout>
                                                                </Grid>
                                                                <Grid x:Name="DailyLow" Padding="4" Grid.Column="1">
                                                                    <Image Source="lowtemp.png" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                                                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                                                                        <Label x:Name="LowTemp" Text="{Binding DailyLow}" FontSize="Caption" FontFamily="Jost" LineBreakMode="WordWrap"/>
                                                                    </VerticalStackLayout>
                                                                </Grid>
                                                            </Grid>
                                                            <Image Source="{Binding DailyIcon, Converter={StaticResource HttpClientConverter}}" HeightRequest="50" WidthRequest="50"/>
                                                            <Label Text="{Binding DailyForecast}" LineBreakMode="WordWrap"/>
                                                        </VerticalStackLayout>

                                                    </DataTemplate>
                                                </CarouselView.ItemTemplate>
                                            </CarouselView>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout x:Name="RightDetails" Grid.Column="1">
                                            <!-- TODO: Change to use PhotoDayModel.HourlyForecast -->
                                            <!-- TODO: Change Days to PhotoDay-->
                                            <CarouselView x:Name="HourlyForecastCarousel" RemainingItemsThreshold="7"  ItemsUpdatingScrollMode="KeepItemsInView" ItemsSource="{Binding SelectedDayPhotoHours}" CurrentItem="{Binding SelectedDayCurrentPhotoHour}">
                                                <CarouselView.ItemTemplate>
                                                    <DataTemplate x:DataType="m:PhotoHour">
                                                        <Grid>
                                                            <HorizontalStackLayout>
                                                                <Label x:Name="TimeOfDay" Text="{Binding TimeOfDay}" />
                                                                <Label x:Name="MonthDate" Text="{Binding SelectedDayCurrentPhotoHour.HourlyForecast.StartTime, StringFormat='{0:WWWW, MMMM, d}'}" />
                                                            </HorizontalStackLayout>
                                                            <!-- TODO: Give each period a name TimeOfDay and Hour maybe make it expandable-->
                                                            <Label x:Name="HourlySection" Text="{Binding HourlyForecastDetail}" FontAttributes="Bold"/>
                                                            <Label x:Name="LocationLabel" Text="{Binding LocationTime}" FontAttributes="Bold"/>
                                                            <Image Source="{Binding SelectedDayCurrentPhotoHour.HourlyForecast.Icon, Converter={StaticResource HttpClientConverter}}"/>
                                                            <Label x:Name="SummaryLabel" Text="Summary:" HorizontalTextAlignment="Start"/>
                                                            <Label x:Name="DetailedSummary" Text="{Binding SelectedDayCurrentPhotoHour.HourlyForecast.DetailForecast}" LineBreakMode="WordWrap"/>

                                                            <VerticalStackLayout Grid.Row="1" x:Name="Events">
                                                                <!-- TODO: Change to use PhotoDayModel.Events -->
                                                                <CollectionView x:Name="EventsCollectionView" ItemsSource="{Binding SelectedDayCurrentPhotoHour.Events}">
                                                                    <CollectionView.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid>
                                                                                <!-- TODO: Show a start and end time. If the event has only a start or end time, hide the respective label -->
                                                                                <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                                                                <Label Text="{Binding OrderTime}" LineBreakMode="WordWrap"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </CollectionView.ItemTemplate>
                                                                </CollectionView>
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </CarouselView.ItemTemplate>
                                            </CarouselView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>