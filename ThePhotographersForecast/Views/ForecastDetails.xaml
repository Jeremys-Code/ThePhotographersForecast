<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThePhotographersForecast.Views.ForecastDetails"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             x:DataType="vm:ForecastDetailsViewModel"
             xmlns:models="clr-namespace:ThePhotographersForecast.Models"
            xmlns:fold="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             BackgroundImageSource="faneuilhall.png"
             Title="Forecast Details">
    <fold:TwoPaneView Pane1Length="1*"
                   Pane2Length="1*"
                   WideModeConfiguration="LeftRight"
                   TallModeConfiguration="TopBottom"
                   MinWideModeWidth="720"
                   MinTallModeHeight="800">
        <fold:TwoPaneView.Pane1>
            <Grid>
                <!-- Background map (first child so it renders behind other content). InputTransparent so UI controls above remain interactive. -->
                <!--<maps:Map MapType="Street" IsShowingUser="False" x:Name="BackgroundMapView" InputTransparent="True" />-->

                <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Never">

                    <VerticalStackLayout>
                        <!--<Grid VerticalOptions="Start" RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" RowSpacing="10" WidthRequest="400">-->
                        <!--<Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="10">-->
                        <Border Stroke="{StaticResource Noon}" 
                        StrokeThickness="4" 
                                Padding="6"
                            Grid.Row="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <!--Header Starts-->
                                <Label Text="The Photographer's Forecast for" HorizontalOptions="Center" LineBreakMode="WordWrap"  Margin="0,30,0,0" FontFamily="NotoThick" FontSize="30" />
                                <Label Text="{Binding LocationName}"  HorizontalOptions="Center" LineBreakMode="WordWrap"  Margin="0,5,0,4" FontFamily="NotoThick" FontSize="30"/>
                                <!--<Label Text="{Binding LocationTime}" HorizontalOptions="Center" HorizontalTextAlignment="End" Margin="0,0,0,8"  FontFamily="NotoSans" FontSize="18"/>-->
                            </VerticalStackLayout>
                        </Border>
                        <!-- ==================== DAILY FORECASTS ==================== -->
                        <VerticalStackLayout Padding="30">
                            <CollectionView x:Name="DailyCollection"
                                            ItemsSource="{Binding DailyForecasts}"
                                            SelectedItem="{Binding SelectedDailyForecast, Mode=TwoWay}"
                                            SelectionMode="Single"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                          >
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" SnapPointsAlignment="Center" SnapPointsType="MandatorySingle" ItemSpacing="10"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:NwsDailyForecast">
                                        <!-- Removed inner ScrollView so the Border can be tapped -->
                                        <Border 
                                Margin="4"                        
                                StrokeThickness="8" 
                                Stroke="{StaticResource GpsBorder}" 
                                Background="{Binding DailyBackgroundBrush}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="10">

                                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="Header" FontFamily="NotoThick" HorizontalOptions="Start" TextDecorations="Underline"  LineBreakMode="WordWrap" />
                                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding StartTime, StringFormat='{0:ddd, MMM d h:mm tt}'}" HorizontalOptions="Center" />
                                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding EndTime, StringFormat='{0:ddd, MMM d h:mm tt}'}" HorizontalOptions="Center" />



                                                <skia:SKLottieView Source="{Binding SkDailyAnimation}" 
                                                            HeightRequest="100" 
                                                                Grid.Column="0"
                                                                Grid.Row="1"           
                                                           WidthRequest="100" 
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Start"
                                                           RepeatCount="-1" 
                                                           RepeatMode="Restart" />
                                                <Label  Text="{Binding TempAndUnit}" Grid.Column="1" Grid.Row="1"  FontSize="40"  FontAttributes="Bold" HorizontalOptions="Center" />
         
                                                    <Label Text="{Binding DetailForecast}" WidthRequest="200" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Justify" LineBreakMode="WordWrap"  HorizontalOptions="Start" FontFamily="NotoSans" VerticalOptions="Start"/>
                                             


                                                
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </fold:TwoPaneView.Pane1>
        <fold:TwoPaneView.Pane2>
            <Grid>
                <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Never">
                    <!-- ==================== HOURLY FORECASTS ==================== -->
                    <VerticalStackLayout Margin="0,15,0,0">
                        <Label Text="Hourly Forecasts" FontAttributes="Bold" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,8" TextColor="{StaticResource Gold}"/>
                        <!-- Removed outer ScrollView Orientation="Both" and added HeightRequest -->
                        <CollectionView x:Name="HourlyCollection"
                    ItemsSource="{Binding SelectedDailyHourlyForecasts}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:NwsHourlyForecast">
                                    <Border 
                        Margin="4" 
                        WidthRequest="180" 
                        HeightRequest="200"
                        StrokeThickness="4" 
                        Stroke="{StaticResource Noon}" 
                        Background="{Binding TimeOfDayBrush}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                                <Label Text="{Binding TempAndUnit}"  FontAttributes="Bold" TextColor="{Binding TimeOfDayTextColor}" />
                                                <Label Text="@"  FontAttributes="Bold" TextColor="{Binding TimeOfDayTextColor}" />
                                                <Label Text="{Binding StartTime, StringFormat='{0:h tt,}'}" FontSize="13" FontAttributes="Bold" TextColor="{Binding TimeOfDayTextColor}" />
                                                <!--<Label Text=" " FontSize="13" FontAttributes="Bold" TextColor="{Binding TimeOfDayTextColor}" />-->
                                                <Label Text="{Binding StartTime, StringFormat='{0:MMM d}'}" FontSize="13" FontAttributes="Bold" TextColor="{Binding TimeOfDayTextColor}" />
                                            </HorizontalStackLayout>

                                            <Grid RowDefinitions="Auto,Auto" Margin="10">
                                                <skia:SKLottieView Source="{Binding SkHourlyAnimation}" 
                                           HeightRequest="80" 
                                                                               Grid.Row="0"
                                           WidthRequest="80" 
                                           HorizontalOptions="Center" 
                                           RepeatCount="-1" 
                                           RepeatMode="Restart" />
                                                <Label x:Name="HourlyAnimationLabel"
                                                                   Text="{Binding DetailedForecast}"
                                                                   FontSize="11"
                                                                   Grid.Row="1"
                                                                   FontFamily="NotoSans"
                                                                   TextColor="{Binding TimeOfDayTextColor}"
                                                                   HorizontalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <BoxView HeightRequest="30" HorizontalOptions="Fill" Background="Transparent"/>
                        <Label Text="Upcoming Moon Phases" FontAttributes="Bold" FontFamily="NotoThick" HorizontalOptions="Center"/>
                        <!--<CarouselView HeightRequest="200"
                     WidthRequest="200"
                                    HorizontalOptions="Center"
                     ItemsSource="{Binding MoonPhases}"
                     CurrentItem="{Binding SelectedMoonPhase, Mode=TwoWay}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="models:FutureMoonPhase">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" HeightRequest="180">
                                        <Label Grid.Row="0" Text="{Binding LocalDateString}" HorizontalOptions="Center"/>
                                        <Label Grid.Row="1" Text="{Binding LocalTimeString}" HorizontalOptions="Center"/>
                                        <skia:SKLottieView Source="{Binding SkMoonSource}" Grid.Row="2" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center"/>
                                        <Label Grid.Row="3" Text="{Binding MoonPhaseName}" HorizontalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>-->
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </fold:TwoPaneView.Pane2>
    </fold:TwoPaneView>
</ContentPage>
