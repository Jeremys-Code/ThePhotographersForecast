<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThePhotographersForecast.Views.DataCheck"
             xmlns:component="clr-namespace:ThePhotographersForecast.Components"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:DataType="vm:DataCheckViewModel"
             Title="API Model Comparison"
             Background="{StaticResource EarlyMorning}">

    <Grid RowDefinitions="Auto,*" Padding="24,20" RowSpacing="18">

        <!-- Page Header -->
        <Border Grid.Row="0"
                Stroke="#40FFFFFF"
                StrokeThickness="1.5"
                BackgroundColor="#22000000"
                Padding="20,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="14" Opacity="0.45"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Trials &amp; Tribulations of Balancing Meteorological Model APIs"
                       FontFamily="NotoThick"
                       FontAttributes="Bold"
                       FontSize="22"
                       TextColor="White"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding Title}"
                       FontFamily="NotoSans"
                       FontSize="14"
                       TextColor="#93C5FD"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Main Two-Column Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="22">

            <!-- Left Column: Date Picker + Daily Model Snapshot -->
            <ScrollView Grid.Column="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="16">

                    <!-- Date Selector Card -->
                    <Border Stroke="#35FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#24000000"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Select a Date"
                                   FontFamily="NotoThick"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="White"/>

                            <CollectionView ItemsSource="{Binding Dates}"
                                            SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                            SelectionMode="Single"
                                            SelectionChangedCommand="{Binding SelectDateCommand}"
                                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="component:CalendarDayModel">
                                        <Border Stroke="{Binding BorderColor}"
                                                StrokeThickness="2"
                                                BackgroundColor="{Binding BackgroundColor}"
                                                HeightRequest="56"
                                                WidthRequest="68"
                                                Padding="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DataCheckViewModel}}, Path=SelectDateCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Date, StringFormat='{0:ddd,}'}"
                                                       FontFamily="NotoSans"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="{Binding TextColor}"
                                                       HorizontalTextAlignment="Center"/>
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d}'}"
                                                       FontFamily="NotoSans"
                                                       FontSize="12"
                                                       TextColor="{Binding TextColor}"
                                                       HorizontalTextAlignment="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Daily Snapshot Card -->
                    <Border Stroke="#35FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#24000000"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Daily Model Snapshot"
                                   FontFamily="NotoThick"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="White"/>

                            <Border BackgroundColor="#203B82F6" Stroke="#603B82F6" StrokeThickness="1" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="NWS Daily" FontFamily="NotoThick" FontSize="12" FontAttributes="Bold" TextColor="#93C5FD"/>
                                    <Label Text="{Binding NwsDailySnapshot}" FontFamily="NotoSans" FontSize="11" TextColor="#E2E8F0" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#2014B8A6" Stroke="#6014B8A6" StrokeThickness="1" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Open-Meteo Daily" FontFamily="NotoThick" FontSize="12" FontAttributes="Bold" TextColor="#5EEAD4"/>
                                    <Label Text="{Binding MeteoDailySnapshot}" FontFamily="NotoSans" FontSize="11" TextColor="#E2E8F0" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Right Column: Comparison Grid (Single Non-Repeating Header Row + Scrollable Rows) -->
            <Border Grid.Column="1"
                    Stroke="#45FFFFFF"
                    StrokeThickness="1.5"
                    BackgroundColor="#26000000"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="18" Opacity="0.5"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*">

                    <!-- Single Non-Repeating Header Row -->
                    <Border Grid.Row="0"
                            BackgroundColor="#50081F43"
                            Stroke="#30FFFFFF"
                            StrokeThickness="4"
                            Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,0,0"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="1.1*,2*,2*" ColumnSpacing="14">
                            <Label Grid.Column="0"
                                   Text="Astronomical Event"
                                   FontFamily="NotoThick"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="White"
                                   VerticalOptions="Center"/>

                            <Border Grid.Column="1" BackgroundColor="#303B82F6" Stroke="#8060A5FA" StrokeThickness="1" Padding="10,4" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="National Weather Service"
                                       FontFamily="NotoThick"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#BFDBFE"/>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="#3014B8A6" Stroke="#802DD4BF" StrokeThickness="1" Padding="10,4" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label Text="Open-Meteo"
                                       FontFamily="NotoThick"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#99F6E4"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Data Rows -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding ComparisonRows}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30" Spacing="6">
                                <Label Text="No event comparison data for this date."
                                       FontFamily="NotoThick"
                                       FontSize="15"
                                       TextColor="#CBD5E1"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Select another date on the left to compare NWS and Open-Meteo forecasts."
                                       FontFamily="NotoSans"
                                       FontSize="12"
                                       TextColor="#94A3B8"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventComparisonRow">
                                <Border BackgroundColor="{Binding RowBackgroundColor}"
                                        Stroke="#22FFFFFF"
                                        StrokeThickness="4"
                                        Padding="16,12">
                                    <Grid ColumnDefinitions="1.1*,2*,2*" ColumnSpacing="14">

                                        <!-- Col 0: Event Info -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding EventName}"
                                                   FontFamily="NotoThick"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="#FDE047"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding TimeLabel}"
                                                   FontFamily="NotoSans"
                                                   FontSize="12"
                                                   TextColor="#E2E8F0"/>
                                            <Label Text="{Binding OtherTimeLabel}"
                                                   IsVisible="{Binding HasOtherTime}"
                                                   FontFamily="NotoSans"
                                                   FontSize="12"
                                                   TextColor="#CBD5E1"/>
                                        </VerticalStackLayout>

                                        <!-- Col 1: NWS Forecast -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <skia:SKLottieView Source="{Binding NwsAnimation}"
                                                                   RepeatCount="-1"
                                                                   RepeatMode="Restart"
                                                                   WidthRequest="36"
                                                                   HeightRequest="36"
                                                                   VerticalOptions="Center"/>
                                                <Border BackgroundColor="#353B82F6" Padding="8,2" StrokeThickness="0" VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                    <Label Text="{Binding NwsTemp}"
                                                           FontFamily="NotoThick"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           TextColor="White"/>
                                                </Border>
                                                <Label Text="{Binding NwsWind}"
                                                       FontFamily="NotoSans"
                                                       FontSize="11"
                                                       TextColor="#BAE6FD"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding NwsForecast}"
                                                   FontFamily="NotoSans"
                                                   FontSize="12"
                                                   TextColor="#F1F5F9"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>

                                        <!-- Col 2: Open-Meteo Forecast -->
                                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <skia:SKLottieView Source="{Binding MeteoAnimation}"
                                                                   RepeatCount="-1"
                                                                   RepeatMode="Restart"
                                                                   WidthRequest="36"
                                                                   HeightRequest="36"
                                                                   VerticalOptions="Center"/>
                                                <Border BackgroundColor="#3514B8A6" Padding="8,2" StrokeThickness="0" VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                    <Label Text="{Binding MeteoTemp}"
                                                           FontFamily="NotoThick"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           TextColor="White"/>
                                                </Border>
                                                <Label Text="{Binding MeteoWind}"
                                                       FontFamily="NotoSans"
                                                       FontSize="11"
                                                       TextColor="#99F6E4"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding MeteoForecast}"
                                                   FontFamily="NotoSans"
                                                   FontSize="12"
                                                   TextColor="#F1F5F9"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>