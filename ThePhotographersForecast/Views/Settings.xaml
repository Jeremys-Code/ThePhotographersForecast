<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ThePhotographersForecast.Views.Settings"
             x:Name="Preferences"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:local="clr-namespace:ThePhotographersForecast"
             x:DataType="vm:SettingsViewModel"
             BackgroundImageSource="faneuilhall.png"
             Title="Preferences">
    <ScrollView Orientation="Vertical">
    <Grid>
        <Image Source="faneuilhall.png" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Start"/>
            <Grid VerticalOptions="Center" Padding="20" HorizontalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <VerticalStackLayout Grid.Column="1">
                    <Label 
            Text="Please select your preferences:"
            FontFamily="ManFont"
            VerticalOptions="Center" 
          HorizontalOptions="Center" 
            Margin="12"/>
                    <Label Text="Temperature Units:"
      Style="{StaticResource PickerLabelStyle}"
               IsVisible="{Binding SelectedTemperatureUnit}" />
                    <Picker 
            x:Name="TempUnitPicker" 
           Style="{StaticResource PickerStyle}" 
            Margin="4"
            ItemDisplayBinding="{Binding UnitName}"
            ItemsSource="{Binding TemperatureUnits}"
            SelectedItem="{Binding SelectedTemperatureUnit}"/>
                    <Label Text="Precipitation Units:"
Style="{StaticResource PickerLabelStyle}"
 IsVisible="{Binding SelectedPrecipitationUnit}" />
                    <Picker 
     x:Name="PrecipUnitPicker" 
        Style="{StaticResource PickerStyle}"
            ItemsSource="{Binding PrecipitationUnits}"
            ItemDisplayBinding="{Binding UnitName}"
            SelectedItem="{Binding SelectedPrecipitationUnit}"/>
                    <Label Text="Wind Speed Units:"
Style="{StaticResource PickerLabelStyle}"
 IsVisible="{Binding SelectedWindSpeedUnit}" />
                    <Picker
            x:Name="WindUnitPicker"
           Style="{StaticResource PickerStyle}"
            ItemsSource="{Binding WindSpeedUnits}"
            ItemDisplayBinding="{Binding UnitName}"
            SelectedItem="{Binding SelectedWindSpeedUnit}"/>
                    <Button x:Name="SavePreferencesButton" Style="{StaticResource ButtonStyle}" Text="Save Preferences" Command="{Binding SavePreferencesCommand}"/>
                    <Label Text="{Binding SaveStatusMessage}" IsVisible="{Binding IsSaved}" FontFamily="ManFont" TextColor="{StaticResource GlowInDark}" VerticalOptions="Center" HorizontalOptions="Center" Margin="12"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>