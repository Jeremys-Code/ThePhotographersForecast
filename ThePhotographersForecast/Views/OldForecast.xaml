<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:foldable="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:service="clr-namespace:ThePhotographersForecast.Services"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             x:Class="ThePhotographersForecast.Views.Forecast"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models"
             xmlns:cv="clr-namespace:ThePhotographersForecast.ContentViews"
             x:DataType="vm:ForecastViewModel"
             BackgroundImageSource="backbay.jpg">
    <ScrollView VerticalScrollBarVisibility="Default" HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout HorizontalOptions="Center" Margin="4,0,4,0">
            <cv:TpfHeader />
            <Label Text="Your Photographer's Forecast for: " FontSize="14" HorizontalTextAlignment="Center" TextColor="{StaticResource MidnightBlue}" FontFamily="ManFont" />
            <Label Text="{Binding DisplayName}" FontSize="16" TextColor="{StaticResource MidnightBlue}" Margin="0,0,0,8" HorizontalTextAlignment="Center" FontFamily="NotoSans" LineBreakMode="WordWrap"/>
            <FlexLayout Direction="Row" Wrap="Wrap" AlignContent="SpaceAround" JustifyContent="Center">
                <Grid Margin="4,0,4,0">
                    <Label Text="Selected Location Time" FontFamily="NotoSans" FontSize="14" TextColor="{StaticResource MidnightBlue}" HorizontalTextAlignment="Center" Margin="0,8"/>
                    <Label Text="{Binding CurrentTime}" TextColor="{StaticResource MidnightBlue}" FontSize="14" FontFamily="NotoSans"/>
                </Grid>
            </FlexLayout>
            <VerticalStackLayout HorizontalOptions="Center">
                <CollectionView x:Name="CalendarDates" 
                                    ItemSizingStrategy="MeasureAllItems"
                                    ItemsSource="{Binding Dates}" 
                                    SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    Margin="0,4">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="5" Orientation="Horizontal"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="DateContainer" Style="{StaticResource DateBorder}">
                                <VerticalStackLayout>
                                    <Label x:Name="DateLabel" 
                                               Text="{Binding ., StringFormat='{}{0:dddd, MMM dd @ htt}'}"
                                               VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                               HorizontalOptions="Center"
                                               LineBreakMode="WordWrap"
                                               HorizontalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="1" Command="{Binding OnSelectedDateChangedCommand}" CommandParameter="{Binding SelectedDate}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center">
                <VerticalStackLayout>
                    <Label x:Name="ForecastTitle" Text="The Photographer's Forecast for" FontFamily="ManFont" FontSize="Title" HorizontalOptions="Center"/>
                    <Label x:Name="DateTitle" Text="{Binding TimePeriod}" FontSize="Header" FontFamily="ManFont" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <VerticalStackLayout>
                <CollectionView ItemSizingStrategy="MeasureAllItems" ItemsSource="{Binding Dailys}" SelectedItem="{Binding SelectedDaily}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="WeatherEventResults" Style="{StaticResource ContentBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.ColumnSpan="2" Grid.Row="0" x:Name="DailyName" Text="{Binding Name}" HorizontalOptions="Center" FontAutoScalingEnabled="True"/>
                                    <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="5">
                                        <VerticalStackLayout>
                                            <Label Text="Forecast for:"/>
                                            <HorizontalStackLayout>
                                                <Label Text="{Binding StartTime, StringFormat= '{}{0:htt}'}"/>
                                                <Label Text="-"/>
                                                <Label Text="{Binding EndTime, StringFormat='{}{1:htt}'}"/>
                                            </HorizontalStackLayout>
                                            <Image x:Name="DailyWeatherImage" Source="{Binding DailyImageSource}" Aspect="AspectFill" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center"/>
                                            <Label Text="Weather Summary:" FontFamily="ManFont" FontSize="14" HorizontalOptions="Start" />
                                            <Label x:Name="Summary" Text="{Binding DailyForecast}" LineBreakMode="WordWrap" FontSize="12" FontFamily="NotoSans"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="5">
                                        <CollectionView ItemsSource="{Binding SelectedDailyEvents}" HorizontalOptions="Center">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <VerticalStackLayout x:DataType="model:EventTime">
                                                            <Label Text="Event:"/>
                                                            <Label Text="{Binding EventName}"/>
                                                            <Label Text="{Binding AstroTime, StringFormat='{}{2:htt}'}"/>
                                                            <Label Text="{Binding OtherTime, TargetNullValue='', StringFormat='{}{3:htt}'}"/>
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout x:DataType="model:HourlyForecast">
                                                            <Label Text="{Binding Name}"/>
                                                            <Image Source="{Binding HourlyIcon}" Aspect="AspectFill" HeightRequest="48" WidthRequest="48" HorizontalOptions="Center"/>
                                                            <Label Text="{Binding WeatherSummary}" LineBreakMode="WordWrap"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
    
