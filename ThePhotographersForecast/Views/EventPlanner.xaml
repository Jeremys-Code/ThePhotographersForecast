<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:models="clr-namespace:ThePhotographersForecast.Models"
             x:Class="ThePhotographersForecast.Views.EventPlanner"
             x:DataType="vm:EventPlannerViewModel"
             Title="Event Planner"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- HEADER: Location & Date Selection -->
            <Border Stroke="{StaticResource GpsBorder}" 
                    StrokeThickness="3" 
                    Background="{StaticResource BlueBorderBackground}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Atmospheric Event Planning" 
                           FontSize="24" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding LocationName}" 
                           FontSize="18" 
                           FontFamily="NotoSans"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding ElevationStatement}" 
                           FontSize="13" 
                           FontFamily="NotoSans"
                           HorizontalTextAlignment="Center"
                           Opacity="0.8"/>
                </VerticalStackLayout>
            </Border>

            <!-- DATE SELECTOR -->
            <Border Stroke="{StaticResource Gray400}" 
                    StrokeThickness="1" 
                    Padding="12"
                    Background="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" 
                            Text="Previous" 
                            FontSize="12"
                            Padding="12,8"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray400}"
                            BorderWidth="1"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            Command="{Binding PreviousDateCommand}"/>
                    <Label Grid.Column="1" 
                           Text="{Binding SelectedDate, StringFormat='{0:dddd, MMM d}'}" 
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"
                           FontFamily="NotoSans"
                           FontSize="14"/>
                    <Button Grid.Column="2" 
                            Text="Next" 
                            FontSize="12"
                            Padding="12,8"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Gray400}"
                            BorderWidth="1"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            Command="{Binding NextDateCommand}"/>
                </Grid>
            </Border>

            <!-- SKY COLOR SECTION -->
            <Border Stroke="{StaticResource Noon}" 
                    StrokeThickness="2" 
                    Padding="16"
                    Background="{Binding SelectedDaySkyGradient}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sky Color Today" 
                           FontSize="18" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="{Binding SkyColorExplanation}" 
                           FontSize="12" 
                           FontFamily="NotoSans"
                           LineBreakMode="WordWrap"
                           TextColor="White"
                           Opacity="0.95"/>
                </VerticalStackLayout>
            </Border>

            <!-- DAY INFORMATION: Sunrise, Sunset, Day Length -->
            <Border Stroke="{StaticResource GpsBorder}" 
                    StrokeThickness="2" 
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFBF0, Dark=#2B2416}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Solar &amp; Day Information" 
                           FontSize="16" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                        <!-- Sunrise -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="☀️ Sunrise" 
                                   FontSize="12" 
                                   FontFamily="NotoSans" 
                                   FontAttributes="Bold"
                                   Opacity="0.7"/>
                            <Label Text="{Binding SunriseStatement}" 
                                   FontSize="14" 
                                   FontFamily="NotoSans"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Sunset -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="🌅 Sunset" 
                                   FontSize="12" 
                                   FontFamily="NotoSans" 
                                   FontAttributes="Bold"
                                   Opacity="0.7"/>
                            <Label Text="{Binding SunsetStatement}" 
                                   FontSize="14" 
                                   FontFamily="NotoSans"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Day Length -->
                        <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="4">
                            <Label Text="📅 Day Length" 
                                   FontSize="12" 
                                   FontFamily="NotoSans" 
                                   FontAttributes="Bold"
                                   Opacity="0.7"/>
                            <Label Text="{Binding DayLengthStatement}" 
                                   FontSize="14" 
                                   FontFamily="NotoSans"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Sunshine Duration -->
                        <VerticalStackLayout Grid.Column="1" Grid.Row="1" Spacing="4">
                            <Label Text="☀️ Sunshine" 
                                   FontSize="12" 
                                   FontFamily="NotoSans" 
                                   FontAttributes="Bold"
                                   Opacity="0.7"/>
                            <Label Text="{Binding SunshineDurationStatement}" 
                                   FontSize="14" 
                                   FontFamily="NotoSans"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- MOON PHASE SECTION -->
            <Border Stroke="{StaticResource PeriodNight}" 
                    StrokeThickness="2" 
                    Padding="16"
                    Background="{AppThemeBinding Light=#F0F0FF, Dark=#1A1A2E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌙 Moon Phase" 
                           FontSize="16" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"/>

                    <Label Text="{Binding MoonPhaseStatement}" 
                           FontSize="14" 
                           FontFamily="NotoSans"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- ASTRONOMICAL EVENTS TIMELINE -->
            <Border Stroke="{StaticResource Gold}" 
                    StrokeThickness="2" 
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFF0, Dark=#2B2B1A}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="⭐ Astronomical Events" 
                           FontSize="16" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"/>

                    <!-- Events List -->
                    <CollectionView ItemsSource="{Binding SelectedDayEventTimes}"
                                    HeightRequest="300"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EventTime">
                                <Border Stroke="{StaticResource Gold}" 
                                        StrokeThickness="1" 
                                        Padding="12"
                                        Background="{AppThemeBinding Light=#FAFAF0, Dark=#1F1F15}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" 
                                                            VerticalOptions="Center">
                                            <Label Text="{Binding AstroTime, StringFormat='{0:h:mm tt}'}" 
                                                   FontSize="14" 
                                                   FontFamily="NotoSans"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gold}"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding EventName}" 
                                                   FontSize="14" 
                                                   FontFamily="NotoSans"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding TimeLabel}" 
                                                   FontSize="12" 
                                                   FontFamily="NotoSans"
                                                   Opacity="0.7"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding OtherTimeLabel}" 
                                                   FontSize="12" 
                                                   FontFamily="NotoSans"
                                                   Opacity="0.7"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyViewTemplate>
                            <DataTemplate>
                                <Label Text="No astronomical events for this date." 
                                       FontSize="12" 
                                       Opacity="0.6"
                                       HorizontalTextAlignment="Center"
                                       Margin="16"/>
                            </DataTemplate>
                        </CollectionView.EmptyViewTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- WEATHER SUITABILITY SECTION -->
            <Border Stroke="{StaticResource PeriodAfternoon}" 
                    StrokeThickness="2" 
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFF5E6, Dark=#2B2416}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="🌤️ Photography Conditions" 
                           FontSize="16" 
                           FontFamily="NotoThick" 
                           FontAttributes="Bold"/>
                    <Label Text="{Binding WeatherSuitabilityStatement}" 
                           FontSize="12" 
                           FontFamily="NotoSans"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- INSTRUCTIONS -->
            <Label Text="{Binding Instructions}" 
                   FontSize="11" 
                   FontFamily="NotoSans"
                   LineBreakMode="WordWrap"
                   Opacity="0.7"
                   Margin="0,8"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
