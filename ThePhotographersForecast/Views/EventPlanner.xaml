<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fold="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
             xmlns:components="clr-namespace:ThePhotographersForecast.Components"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:models="clr-namespace:ThePhotographersForecast.Models"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:DataType="vm:EventPlannerViewModel"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             x:Class="ThePhotographersForecast.Views.EventPlanner"
             xmlns:shared="clr-namespace:ThePhotographersForecast.Shared"
             Title="Event Planner">
    <fold:TwoPaneView Pane1Length="1*"
                      Pane2Length="1*"
                      PanePriority="Pane1"
                      WideModeConfiguration="LeftRight"
                      TallModeConfiguration="TopBottom"
                      MinWideModeWidth="720"
                      MinTallModeHeight="800">
        <!-- PANE 1: Context & Spatial Map (Unfolded Left / Portrait Top) -->
            <fold:TwoPaneView.Pane1>
            <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,*">
                <Label x:Name="Title" 
                       Text="The Photographer's Forecast" 
                       Grid.Row="1" 
                       FontFamily="ManFont" 
                       HorizontalTextAlignment="Center" 
                       HorizontalOptions="Fill" 
                      VerticalTextAlignment="Start" 
                       Margin="15" 
                       Shadow="8,8,16,#BEFCA6,0.7" 
                       TextColor="Black"/>
                <Label x:Name="InstructionText" 
        Grid.Row="2"
        HorizontalOptions="Start"
        VerticalOptions="Start"
        HorizontalTextAlignment="Start"
        Text="{Binding Instructions}" FontFamily="ManFont"/>
                <components:RangeCalendarView x:Name="Calendar"
                                              Grid.Row="3"
                                              CalendarDays="{Binding SharedSession.Dates}"
                                              EndDate="{Binding SharedSession.EndDate}"
                                              StartDate="{Binding SharedSession.StartDate}"
                                              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>

                <!--<<Grid Grid.Row="4" HorizontalOptions="Fill" MinimumHeightRequest="200" RowSpacing="10">
                        <Border StrokeThickness="4" HorizontalOptions="Fill" StrokeShape="RoundRectangle 15" Stroke="{StaticResource Noon}" Padding="10">
                            skia:SKLottieView x:Name="ForecastOutlook" Source="{Binding SelectedDayDayPeriodsParade}">
                            <skia:SKLottieView.ControlTemplate>
                                <ControlTemplate>
                                    <skia:SKLottieView x:Name="LottieAnimation" />
                                    <skia:SKLottieView x:Name="LottieTime" />
                                    -->
                <!-- Use SKGLView for GPU-accelerated rendering -->
                <!--
                                    <skia:SKGLView x:Name="PART_DrawingSurface" />
                                </ControlTemplate>
                            </skia:SKLottieView.ControlTemplate>
                        </skia:SKLottieView>

                        </Border>-->
        
            <Grid Grid.Row="4" RowDefinitions="Auto,Auto" HorizontalOptions="Fill">
                        <Grid Grid.Row="0">
                            <Border Stroke="Red" StrokeThickness="2" HorizontalOptions="Fill" VerticalOptions="Fill" Background="#70FF0000">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="30,30,0,0" />
                                </Border.StrokeShape>
                                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <VerticalStackLayout Margin="8">
                                            <Label Text="The High" FontAttributes="Bold" VerticalOptions="Center" FontFamily="ManFont" HorizontalOptions="Start" FontSize="24" HorizontalTextAlignment="Start" Margin="2" TextColor="#701705"/>
                                            <Label Text="{Binding DailyHigh, Mode=TwoWay}" HorizontalOptions="Start" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" VerticalOptions="Center" TextColor="#701705" Margin="2" FontSize="24" FontFamily="ManFont"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="8">
                                        <skia:SKLottieView x:Name="HighTempAnimation" Source="{Binding DailyLow, Mode=TwoWay}" RepeatCount="-1" RepeatMode="Restart"  HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Border Stroke="Blue" HorizontalOptions="Fill" VerticalOptions="Fill" StrokeThickness="2" Background="#700000FF">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,0,30,30" />
                                </Border.StrokeShape>
                                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <VerticalStackLayout Margin="8">
                                            <Label Text="The Low" FontAttributes="Bold" VerticalOptions="Center" FontFamily="ManFont" HorizontalOptions="Start" FontSize="24" HorizontalTextAlignment="Start" Margin="2" TextColor="{StaticResource MidnightBlue}"/>
                                            <Label Text="{Binding Shared, Mode=TwoWay}" HorizontalOptions="Start" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" VerticalOptions="Center" TextColor="{StaticResource MidnightBlue}" Margin="2" FontSize="24" FontFamily="ManFont"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="8">
                                        <skia:SKLottieView x:Name="LowTempAnimation" HeightRequest="80" RepeatCount="-1" RepeatMode="Restart" WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!--<CollectionView x:Name="SuggestionsList"
                                ItemSizingStrategy="MeasureAllItems"
                                IsVisible="{Binding ShowSuggestions}" 
                                ItemsSource="{Binding Suggestions}"  
                                SelectedItem="{Binding SelectedLocation}"
                                SelectionChangedCommand="{Binding SelectedSuggestionCommand}"
                                SelectionChangedCommandParameter="{Binding SelectedLocation}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                SelectionMode="Single"
                                Header="Location Suggestions"
                                MaximumHeightRequest="220">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PhotoLocation">
                                    <VerticalStackLayout Margin="0, 4">
                                        <Label Text="{Binding DisplayName}"
                                       HorizontalTextAlignment="Start" 
                                       FontAttributes="Bold"        
                                       LineBreakMode="WordWrap"  
                                       FontFamily="NotoSans"
                                       FontSize="13"
                                       Padding="4,2"/>
                                        <BoxView HeightRequest="1" Color="#9FA4AC"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>-->


                    <Border x:Name="BusyWorkingIndicator" 
                        StrokeShape="RoundRectangle 15" 
                        Grid.Row="5"
                        Stroke="{StaticResource GpsBorder}"
                        Background="{StaticResource BlueBorderBackground}"
                        Margin="15"
                        Padding="8"
                        IsVisible="{Binding IsWorking}"
                        IsEnabled="{Binding IsWorking}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                        <Grid x:Name="Busy" RowDefinitions="Auto,Auto,*" HorizontalOptions="Fill">
                            <ActivityIndicator IsVisible="{Binding IsWorking}"
                        IsRunning="{Binding IsWorking}"
                        IsEnabled="{Binding IsWorking}"
                        Grid.Row="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                       Color="#BEFCA6"
                       HeightRequest="200"
                       WidthRequest="200"/>
                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" HorizontalOptions="Fill">
                                <Label x:Name="ProgressActivity" 
                                       HorizontalOptions="Center" 
                                       Grid.Row="0"
                                       Text="{Binding ProgressMessage}" 
                                       HorizontalTextAlignment="Center" 
                                       FontFamily="ManFont"
                                       LineBreakMode="WordWrap" 
                                       TextColor="{StaticResource GlowInDark}" 
                                       Shadow="2,2,2,Black,0.9" 
                                       IsVisible="{Binding IsWorking}"/>
                                <ProgressBar x:Name="DataProgressBar" 
                                             Grid.Row="1"
                                             HorizontalOptions="Fill"
                                             ProgressColor="#BEFCA6" 
                                             Shadow="2,2,2,Black,0.9" 
                                             IsVisible="{Binding IsWorking}" 
                                             Margin="10" 
                                             Progress="{Binding Progress}"/>
                                <Label x:Name="PercentComplete" 
                                       TextColor="#BEFCA6" 
                                       Grid.Row="2"
                                       FontFamily="NotoSans"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Shadow="2,2,2,Black,0.9" 
                                       Text="{Binding Progress, StringFormat='{}Completed {0}%'}"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!--<maps:Map x:Name="BackgroundMapView" InputTransparent="True" />-->
                    <!--<VerticalStackLayout Padding="16" Spacing="8">
                    <Border Style="{StaticResource HeaderCardStyle}">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding LocationName}" Style="{StaticResource TitleStyle}" />
                            <Label Text="Photo Opportunity Conditions" Style="{StaticResource SubtitleStyle}" />
                        </VerticalStackLayout>
                    </Border>
                    -->
                    <!-- Moon Phase / Sun Position Companion Widget -->
                    <!--
                    <components:MoonPhasesCarouselView HeightRequest="140" />
                </VerticalStackLayout>-->
                </Grid>
            </fold:TwoPaneView.Pane1>

            <!-- PANE 2: Timeline & Detailed Forecasts (Unfolded Right / Portrait Bottom) -->
        <fold:TwoPaneView.Pane2>
            <Grid x:Name="PaneContentGrid" Padding="15">
                <CollectionView x:Name="EventForecastCard" 
                            HorizontalOptions="Center"
                            ItemsSource="{Binding Days}"
                            SelectedItem="{Binding SelectedDay, Mode=TwoWay}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" SnapPointsAlignment="Center" SnapPointsType="MandatorySingle"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NwsDailyForecast">
                            <Grid Padding="4,8,4,16">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="FlipStates">
                                        <VisualState Name="Flipped">
                                            <VisualState.Setters>
                                                <Setter TargetName="FrontView" Property="VisualElement.RotationY" Value="-180" />
                                                <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter TargetName="FrontView" Property="VisualElement.RotationY" Value="0" />
                                                <Setter TargetName="CardBack" Property="VisualElement.RotationY" Value="180" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <!-- Root card border & elevation -->
                                <VerticalStackLayout>
                                    <!-- Card Tap Gesture-->
                                    <Border StrokeShape="RoundRectangle 24" 
    Stroke="{StaticResource Moon}"
    Background="{StaticResource ForecastBackground}"
    StrokeThickness="2">
                                        <!--<Border.Shadow>
                                                <Shadow Brush="#000000"
                                 Offset="0,8"
                                 Radius="16"
                                 Opacity="0.45"/>
                                            </Border.Shadow>-->
                                        <Grid>
                                            <!--Front of Card-->
                                            <Grid x:Name="FrontView" 
                          RowDefinitions="Auto,*,Auto" 
                          IsVisible="True">
                                                <!-- Front Header -->
                                                <Border Grid.Row="0" 
                                StrokeShape="RoundRectangle 24,24,0,0" 
                                HeightRequest="100"
                                VerticalOptions="Start"
                                Background="{StaticResource BlueBorderBackground}">
                                                    <VerticalStackLayout Padding="16" 
                                                 HorizontalOptions="Center">
                                                        <Label x:Name="CardTitle" 
                                       Text="{Binding Name}" 
                                       FontAutoScalingEnabled="True" 
                                       FontFamily="ManFont" 
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>

                                                        <!-- Date -->
                                                        <HorizontalStackLayout>
                                                            <Label Text="Start TIme:"/>
                                                            <Label Text="{Binding StartTime, StringFormat='{}{0:F}'}"/>
                                                            <Label Text=" End TIme:"/>
                                                            <Label Text="{Binding EndTime, StringFormat='{}{1:F}'}"/>
                                                        </HorizontalStackLayout>


                                                    </VerticalStackLayout>
                                                </Border>
                                                <!-- Front card body -->
                                                <Grid Grid.Row="1" 
                              ColumnDefinitions="*,Auto" 
                              ColumnSpacing="10" 
                              RowSpacing="10" 
                              RowDefinitions="Auto,*,Auto" 
                              Padding="20">
                                                    <Border Grid.Row="0" Grid.Column="0" HorizontalOptions="Fill" HeightRequest="210" StrokeShape="RoundRectangle 15" Stroke="{StaticResource Noon}" Margin="10" VerticalOptions="Start">
                                                        <Label x:Name="CardSubTitle" 
                                           Text="{Binding ShortForecast}" 
                                            LineBreakMode="WordWrap"
                                            HorizontalTextAlignment="Start"
                                            HorizontalOptions="Start"
                                            FontAutoScalingEnabled="True" 
                                            FontFamily="NotoSans"/>
                                                    </Border>
                                                    <VerticalStackLayout Grid.Row="1" 
                                                 Grid.Column="1"
                                                 Grid.ColumnSpan="2"
                                                 Padding="5">
                                                        <!--Daily High and Low-->
                                                        <Grid RowDefinitions="*,*">
                                                            <Border Stroke="Red" StrokeThickness="2" HorizontalOptions="Fill" VerticalOptions="Fill" Background="#70FF0000">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="15,15,0,0" />
                                                                </Border.StrokeShape>
                                                                <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" VerticalOptions="Fill">

                                                                    <VerticalStackLayout Grid.Column="0" Margin="8">
                                                                        <Label Text="The High" FontAttributes="Bold" FontFamily="ManFont" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="2" TextColor="#701705"/>
                                                                        <Label Text="{Binding DailyHigh}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" TextColor="#701705" Margin="2" FontFamily="NotoSans"/>
                                                                    </VerticalStackLayout>
                                                                    <Grid Grid.Column="1" Margin="8">
                                                                        <skia:SKLottieView x:Name="HighTempAnimation" RepeatCount="-1" RepeatMode="Restart" HorizontalOptions="Fill" VerticalOptions="Fill" Margin="10,5,10,5"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                        <Grid Grid.Row="1">
                                                            <Border Stroke="Blue" HorizontalOptions="Fill" VerticalOptions="Fill" StrokeThickness="2" Background="#700000FF">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="0,0,15,15" />
                                                                </Border.StrokeShape>
                                                                <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="0">
                                                                        <VerticalStackLayout Margin="8">
                                                                            <Label Text="The Low" FontAttributes="Bold" VerticalOptions="Center" FontFamily="ManFont" HorizontalOptions="Start" FontSize="24" HorizontalTextAlignment="Start" Margin="2" TextColor="#FFF6F3C0"/>
                                                                            <Label Text="{Binding DailyLow}" HorizontalOptions="Start" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" VerticalOptions="Center" TextColor="#F6F3C0" Margin="2" FontSize="24" FontFamily="ManFont"/>
                                                                        </VerticalStackLayout>
                                                                    </Grid>
                                                                    <Grid Grid.Column="1" Margin="8">
                                                                        <skia:SKLottieView x:Name="LowTempAnimation" HeightRequest="80" RepeatCount="-1" RepeatMode="Restart"  WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                    <Label x:Name="TempLabel" 
                                       Text="Temp:" 
                                       FontFamily="NotoSans" 
                                       FontSize="Caption" 
                                       HorizontalTextAlignment="Start" 
                                       VerticalTextAlignment="Start"/>
                                                    <Label x:Name="Temp" 
                                       Text="{Binding DetailForecast}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Fill" 
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center"/>
                                                    <!--<skia:SKLottieView Grid.Row="0" 
                                                       Grid.Column="1" 
                                                       Source="{Binding SkDailyAnimation}" 
                                                       HorizontalOptions="Fill" 
                                                       VerticalOptions="Fill" 
                                                       RepeatCount="-1" 
                                                       RepeatMode="Restart"/>-->
                                                    <!--<skia:SKLottieView.ControlTemplate>
                                    <ControlTemplate>
                                        -->
                                                    <!-- Use SKGLView for GPU-accelerated rendering when available -->
                                                    <!--
                                        <skiaViews:SKGLView x:Name="PART_DrawingSurface" />
                                    </ControlTemplate>
                                </skia:SKLottieView.ControlTemplate
                            </skia:SKLottieView>>-->
                                                    <VerticalStackLayout Grid.ColumnSpan="2" 
                                                 Grid.Row="1" 
                                                 Padding="5">
                                                        <Label x:Name="ForecastSummary" 
                                       Text="{Binding DailyForecast.DetailForecast}" 
                                       HorizontalOptions="Fill" 
                                       
                                       HorizontalTextAlignment="Start" 
                                       LineBreakMode="WordWrap"/>
                                                    </VerticalStackLayout>
                                                    <!-- Front Footer-->
                                                    <Grid Grid.Row="2" Padding="16, 10" 
                              Background="{StaticResource ForecastBackground}">
                                                        <Label x:Name="CardFooter" Text="Tap to see more." HorizontalTextAlignment="Center" HorizontalOptions="Center" FontAttributes="Bold"/>
                                                    </Grid>

                                                    <!-- The Back of the Card-->
                                                    <Grid x:Name="CardBack"
                          RowDefinitions="Auto,*,Auto"
                          IsVisible="False"
                          RotationY="-180">
                                                        <!--Back Header -->
                                                        <Grid Grid.Row="0" Padding="16"
                              Background="{StaticResource ForecastBackground}">
                                                            <Label x:Name="BackHeader" Text="Time Of Day" FontAttributes="Bold" FontFamily="ManFont" HorizontalTextAlignment="Center"/>
                                                        </Grid>
                                                        <!-- Back Details -->
                                                        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10">
                                                            <CollectionView x:Name="EventsCollection"
                                          ItemsSource="{Binding Source=Day, Path=SelectedDayEventTimes}"
                                          SelectedItem="{Binding Source=Day, Path=SelectedDayEventTime}"
                                          HeightRequest="350">
                                                                <CollectionView.ItemsLayout>
                                                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                                                                </CollectionView.ItemsLayout>
                                                                <CollectionView.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:EventTime">
                                                                        <Grid Padding="4,8,4,16">
                                                                            <!-- Root card border & elevation -->
                                                                            <Border StrokeShape="RoundRectangle 24" 
                                                    Stroke="{StaticResource Moon}"
                                                    StrokeThickness="2">
                                                                                <Border.Shadow>
                                                                                    <Shadow Brush="#000000"
                                                            Offset="0, 8"
                                                            Radius="16"
                                                            Opacity="0.45"/>
                                                                                </Border.Shadow>
                                                                                <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*">
                                                                                    <Label Text="{Binding EventName}" 
                                                               HorizontalTextAlignment="Center" 
                                                               LineBreakMode="WordWrap" 
                                                               MaxLines="2"
                                                               Grid.Row="0"/>
                                                                                    <Label Text="{Binding TimeLabel}" FontFamily="NotoSans" Grid.Row="1" Grid.Column="0"/>
                                                                                    <Label Text="{Binding OtherTimeLabel}" FontFamily="NotoSans" Grid.Row="1" Grid.Column="1"/>

                                                                                </Grid>

                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </CollectionView.ItemTemplate>
                                                            </CollectionView>

                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </fold:TwoPaneView.Pane2>
    </fold:TwoPaneView>
</ContentPage>


