<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThePhotographersForecast.Views.PhotoTimeTrack"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:m="clr-namespace:ThePhotographersForecast.Models;assembly=ThePhotographersForecast"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels;assembly=ThePhotographersForecast"
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services;assembly=ThePhotographersForecast"
             xmlns:view="clr-namespace:ThePhotographersForecast.Views"
             x:DataType="vm:PhotoTimeTrackViewModel"
             Title="PhotoTimeTrack">
    <VerticalStackLayout>
        <Border Style="{StaticResource ContentBorder}" HorizontalOptions="Center" ZIndex="99" VerticalOptions="Center" IsVisible="{Binding IsWorking}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding ProgressMessage}" HorizontalTextAlignment="Center"   Margin="4,20" LineHeight="2.5"  />
                <ActivityIndicator x:Name="ProgressIndicator"  
     WidthRequest="100" 
     HeightRequest="100" 
     IsEnabled="{Binding IsWorking}"
     IsVisible="{Binding IsWorking}"
     IsRunning="{Binding IsWorking}"
     Style="{StaticResource WaitingSpinner}"
     ZIndex="100"
     VerticalOptions="Center"
     HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>
        <Border Stroke="White" Margin="5" Padding="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <StackLayout HorizontalOptions="Center">
                <Label x:Name="NameLabel" Text="The Photographer's Forecast" Margin="4,0,4,0"   FontFamily="ManFont" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                <Image Source="initials.png" WidthRequest="75" HeightRequest="75" HorizontalOptions="Center"/>


                <Label Text="{Binding SelectedLocation.DisplayName}"   Margin="0,0,0,8" HorizontalTextAlignment="Center" FontFamily="Jost" LineBreakMode="WordWrap"/>
                <Label Text="Current Time" FontFamily="ManFont"   HorizontalTextAlignment="Center" Margin="0,8,0,0"/>

                <Grid Margin="4,0,4,0">
                    <Label Text="{Binding LocationTime}"   FontFamily="Jost"/>
                </Grid>
                <CollectionView x:Name="AvailablePhotoDays" ItemSizingStrategy="MeasureAllItems" ItemsSource="{Binding CalendarDays}" SelectionMode="Single" SelectedItem="{Binding SelectedCalendarDay}" SelectionChangedCommand="{Binding OnSelectedCalendarDayChangedCommand}" SelectionChangedCommandParameter="{Binding SelectedCalendarDay}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <toolkit:UniformItemsLayout MaxColumns="{Binding CalendarDays.Length}">
                                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource HunterGreenBorder}"  BackgroundColor="{StaticResource SailOnBlue}" Margin="5" Padding="5" StrokeThickness="4" WidthRequest="120" HeightRequest="120">
                                    <Label x:Name="DayLabel" Text="{Binding ., StringFormat='{}{0:dddd, MMMM dd}'}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontFamily="Jost" FontSize="10" />
                                </Border>
                            </toolkit:UniformItemsLayout>

                            
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </Border>
        <ScrollView Orientation="Vertical">
            <!--<view:PhotoTimeCarousel  />-->
            <CarouselView x:Name="PhotoTimeSchedule"
                      ItemsSource="{Binding Schedules}"
                      CurrentItem="{Binding SelectedDaySchedule}">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="m:DaySchedule">
                        <Border Stroke="{StaticResource SailOnBlue}" Margin="5" Padding="5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout WidthRequest="250" HorizontalOptions="Center" Margin="0,0,0,8">
                                <Label x:Name="DateLabel"
                                                       Text="{Binding PhotoDate, StringFormat='{}{0:dddd, MMMM d}'}"
                                                       HorizontalOptions="Center" FontFamily="ManFont"/>
                                <CarouselView ItemsSource="{Binding HourSchedules}" CurrentItem="{Binding SelectedHourSchedule}">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate x:DataType="m:PhotoSchedule">
                                            <VerticalStackLayout WidthRequest="200">
                                                <Label Text="{Binding TimeOfDay}" HorizontalOptions="Center" FontFamily="ManFont" Margin="0,0,0,8"/>
                                                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,8">
                                                    <Label x:Name="StartTimeLabel" Text="{Binding StartTime, StringFormat='Start: {0:h tt}'}" HorizontalOptions="Center" FontFamily="ManFont"/>
                                                    <Label x:Name="EndTimeLabel" Text="{Binding EndTime, StringFormat='End: {0:h tt}'}" HorizontalOptions="Center" FontFamily="ManFont"/>
                                                </HorizontalStackLayout>
                                                <Label x:Name="ItemTitle" Text="{Binding Name}" HorizontalTextAlignment="Center" HorizontalOptions="Center" FontAttributes="Italic" FontFamily="Jost" />
                                                <!-- If you have a temperature property on the schedule, change this binding to that property. Otherwise it will remain empty. -->
                                                <Image Source="{Binding  ForecastIcon}" HorizontalOptions="Center" Aspect="AspectFill" HeightRequest="50" WidthRequest="50" Margin="5"/>
                                                <Label x:Name="HourlySummary" Text="{Binding ForecastDetail}" HorizontalOptions="Center" FontFamily="Jost" LineBreakMode="WordWrap"/>
                                                <CarouselView x:Name="EventCarousel" ItemsSource="{Binding Events}" CurrentItem="{Binding SelectedEvent}">
                                                    <CarouselView.ItemTemplate>
                                                        <DataTemplate x:DataType="m:EventTime">
                                                            <Border Stroke="White" Margin="5" Padding="5">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12" />
                                                                </Border.StrokeShape>
                                                                <VerticalStackLayout>
                                                                    <Label x:Name="EventNameLabel" Text="{Binding EventName}"  HorizontalTextAlignment="Center" HorizontalOptions="Center" FontAttributes="Italic" FontFamily="Jost" />
                                                                    <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,8">
                                                                        <Label x:Name="EventStartTimeLabel" Text="{Binding StartTime, StringFormat='Event Start Time: {0:h tt}'}" HorizontalOptions="Center"  FontFamily="ManFont"/>
                                                                        <Label x:Name="EventEndTimeLabel" Text="{Binding EndTime, StringFormat='Event End Time: {0:h tt}'}" HorizontalOptions="Center"  FontFamily="ManFont"/>
                                                                        <!--<Label x:Name="EventStartTimeLabel" Text="{Binding StartTime, StringFormat='Event Start Time: {0:h tt}'}" IsVisible="{Binding StartTime, Converter={StaticResource DateTimeVisibilityConverter}}" HorizontalOptions="Center"  FontFamily="ManFont"/>
                                                                        <Label x:Name="EventEndTimeLabel" Text="{Binding EndTime, StringFormat='Event End Time: {0:h tt}'}" IsVisible="{Binding EndTime, Converter={StaticResource DateTimeVisibilityConverter}}" HorizontalOptions="Center"  FontFamily="ManFont"/>-->
                                                                    </HorizontalStackLayout>
                                                                </VerticalStackLayout>
                                                            </Border>
                                                        </DataTemplate>
                                                    </CarouselView.ItemTemplate>
                                                </CarouselView>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>