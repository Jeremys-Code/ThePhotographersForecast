<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ThePhotographersForecast.ViewModels"
             xmlns:model="clr-namespace:ThePhotographersForecast.Models" 
             xmlns:svc="clr-namespace:ThePhotographersForecast.Services"
             xmlns:components="clr-namespace:ThePhotographersForecast.Components"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:fold="clr-namespace:Microsoft.Maui.Controls.Foldable;assembly=Microsoft.Maui.Controls.Foldable"
             x:Class="ThePhotographersForecast.Views.SelectLocation"
             x:DataType="vm:SelectLocationViewModel"
             BackgroundImageSource="commonwealthmall.jpg"
             Title="The Photographers Forecast - Photo Shoot Location">
    <!--<ContentPage.Resources>
        <ResourceDictionary>
            <svc:ToSkiaLottieConverter x:Key="ToSkiaLottie" />
        </ResourceDictionary>
    </ContentPage.Resources>-->
    <fold:TwoPaneView Pane1Length="1*"
                      Pane2Length="1*"
                      WideModeConfiguration="LeftRight"
                      TallModeConfiguration="TopBottom"
                      MinWideModeWidth="720"
                      MinTallModeHeight="800">
        <fold:TwoPaneView.Pane1>
            <ScrollView>
                <VerticalStackLayout HorizontalOptions="Center">


                    <Grid x:Name="Content" RowDefinitions="Auto,Auto" HorizontalOptions="Fill" VerticalOptions="Fill" RowSpacing="10">
                        <!-- Progress Overlay -->
                        <VerticalStackLayout x:Name="WorkingIndicator" 
            IsVisible="{Binding IsWorking}" 
            IsEnabled="{Binding IsWorking}" 
            Background="{AppThemeBinding Light={StaticResource White75}, Dark={StaticResource Black75}}" 
            HorizontalOptions="Center"
            VerticalOptions="Center"
            ZIndex="900">
                            <ActivityIndicator IsVisible="{Binding IsWorking}"
                   IsRunning="{Binding IsWorking}"
                   IsEnabled="{Binding IsWorking}"
                   HorizontalOptions="Center"/>
                            <Label x:Name="ProgressActivity" Text="{Binding ProgressMessage}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" IsVisible="{Binding IsWorking}"/>
                            <ProgressBar x:Name="DataProgressBar" IsVisible="{Binding IsWorking}" Margin="10" Progress="{Binding Progress}"/>
                            <Label x:Name="PercentComplete" IsVisible="{Binding IsWorking}" HorizontalOptions="Center" Text="{Binding Progress, StringFormat='{}Completed {0:P0}'}"/>
                        </VerticalStackLayout>

                        <!-- Header Title Card -->
                        <Border x:Name="TitleBorder" Grid.Row="0" Margin="10" Stroke="{StaticResource GpsBorder}" StrokeThickness="8" Background="{StaticResource BlueBorderBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout x:Name="TitleParameter" HorizontalOptions="Fill" Padding="10">
                                <Label x:Name="Welcome"                                 
                                   Text="{Binding WelcomeGreeting}" 
                                   LineBreakMode="WordWrap"
                                   HorizontalTextAlignment="Justify"
                                       HorizontalOptions="Center"
                                       FontSize="30"
                                   FontFamily="NotoThick">
                                    <Label.Shadow>
                                        <Shadow Offset="6,6" Brush="{StaticResource GlowInDarkClick}" Opacity="0.9"/>
                                    </Label.Shadow>
                                </Label>
                                <Label x:Name="Photographers" Text="The Photographer's Forecast" HorizontalTextAlignment="Justify" FontSize="32" HorizontalOptions="Center" FontFamily="NotoThick" FontAttributes="Bold">
                                    <Label.Shadow>
                                        <Shadow Offset="6,6" Brush="{StaticResource GlowInDarkClick}" Opacity="0.9"/>
                                    </Label.Shadow>
                                </Label>
                                <!--<FormattedString> Shadow="10,10,16,#befca6,0.9" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                    <Label.FormattedText
                                        <Span Text="The" FontSize="24" LineHeight="1.5" FontFamily="NotoSans" />
                                        <Span Text="P                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      her's" FontSize="48" FontFamily="NotoThick" FontAttributes="Bold" />
                                        <Span Text="Forecast" FontSize="35" FontFamily="NotoSans" LineHeight=".5" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>-->

                            </VerticalStackLayout>
                        </Border>

                        <!-- Main Two-Column Layout from Redesign Mockup -->


                        <!-- LEFT COLUMN: Date Range Selection & Range Calendar -->
                        <Border Grid.Row="1"
                                Stroke="{StaticResource GpsBorder}"
                                StrokeThickness="2"
                                Background="{StaticResource BlueBorderBackground}"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*" 
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" 
                                  HorizontalOptions="Center" 
                                  Margin="0,6,0,10">
                                <!--960-->


                                <Label Text="Please select a date or date range of the photo shoot."
                                       FontFamily="NotoSans"
                                           Grid.Column="0" Grid.Row="0"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                           VerticalOptions="Start"
                                           VerticalTextAlignment="Start"
                                       LineBreakMode="WordWrap"/>

                                <!-- DatePickers-->
                                <VerticalStackLayout Grid.Column="0" Grid.Row="1">
                                    <Label Text="Start Date:" FontFamily="NotoSans" FontAttributes="Bold" />
                                    <DatePicker x:Name="StartDatePicker" Date="{Binding StartDate}" MaximumDate="{Binding MaxDate}" MinimumDate="{Binding MinDate}" Style="{StaticResource DatePickersStyle}"/>
                                    <Label Text="End Date:" FontFamily="NotoSans" FontAttributes="Bold" />
                                    <DatePicker x:Name="EndDatePicker" Date="{Binding EndDate}" MaximumDate="{Binding MaxDate}" MinimumDate="{Binding MinDate}" Style="{StaticResource DatePickersStyle}"/>
                                </VerticalStackLayout>
                                <!-- New Range Calendar Component replacing the two DatePickers 
                                <components:RangeCalendarView
                                        Grid.Column="0" Grid.Row="1"
                                    StartDate="{Binding StartDate, Mode=TwoWay}"
                                    EndDate="{Binding EndDate, Mode=TwoWay}"
                                    MinDate="{Binding MinDate}"
                                    MaxDate="{Binding MaxDate}"
                                    HorizontalOptions="Fill"/>-->



                                <!-- RIGHT COLUMN: Location Selection (GPS / Search) -->

                                <!--<Grid Grid.Column="1"  ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" HorizontalOptions="Fill">-->
                                <Label Text="Please provide the location of your photo shoot. Either click on the GPS button or enter a city and select the location from the suggestions list."
                                       Grid.Row="0" Grid.Column="1"
                                           VerticalTextAlignment="Start"
                                           VerticalOptions="Start"
                                           FontFamily="NotoSans"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <!-- GPS Button -->
                                    <Border x:Name="GpsBttns" 
                                            Grid.Column="0"
                                            Style="{StaticResource GpsButton}" 
                                        StrokeThickness="4" 
                                        Stroke="{StaticResource GpsCircleBorder}" 
                                        HorizontalOptions="Center"
                                        VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                        <ImageButton x:Name="GpsButton" 
                                                 Source="copilotgenmappin.png"
                                                 WidthRequest="40"
                                                 HeightRequest="40"
                                                 VerticalOptions="Start"
                                                 HorizontalOptions="Start"
                                                 Command="{Binding GetGpsCommand}">
                                        </ImageButton>
                                    </Border>

                                    <!-- City Search Entry & Suggestions -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="0" VerticalOptions="Start">
                                        <SearchBar x:Name="InputLocation" 
                                               TextChanged="InputLocation_TextChanged" 
                                                   Grid.Row="0"
                                               HeightRequest="50" 
                                               Background="{StaticResource White}"
                                               PlaceholderColor="{StaticResource Gray600}"
                                                   TextColor="{StaticResource MidnightBlue}"
                                                       CursorPosition="0"
                                                   VerticalOptions="Start"
                                                   Keyboard="Default"
                                                   
                                               HorizontalOptions="Fill"         
                                                   FontFamily="NotoSans"
                                               Placeholder="Enter the location here...">
                                            <SearchBar.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                                            </SearchBar.GestureRecognizers>
                                        </SearchBar>



                                        <CollectionView x:Name="SuggestionsList"
                                                        Grid.Row="1"
                                                    ItemSizingStrategy="MeasureAllItems"
                                                    IsVisible="{Binding ShowSuggestions}" 
                                                    ItemsSource="{Binding Suggestions}"  
                                                    SelectedItem="{Binding SelectedLocation}"
                                                    SelectionChangedCommand="{Binding SelectedSuggestionCommand}"
                                                    SelectionChangedCommandParameter="{Binding SelectedLocation}"
                                                    Background="{StaticResource White75}"
                                                    SelectionMode="Single"
                                                    MaximumHeightRequest="220">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="model:PhotoLocation">
                                                    <VerticalStackLayout Margin="0, 4">
                                                        <Label Text="{Binding DisplayName}"
                                                           HorizontalTextAlignment="Start" 
                                                           VerticalOptions="Center"
                                                           VerticalTextAlignment="Center"      
                                                           LineBreakMode="WordWrap"  
                                                           FontFamily="NotoSans"
                                                           TextColor="{StaticResource MidnightBlue}"
                                                           FontSize="11"
                                                           Margin="4,2"/>
                                                        <BoxView HeightRequest="1" Color="{StaticResource MidnightBlue}"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </fold:TwoPaneView.Pane1>
        <fold:TwoPaneView.Pane2 >
            <VerticalStackLayout>
                <Grid HorizontalOptions="Center">

                    <CollectionView x:Name="Daily" 
                                  IsEnabled="True"
                                  IsVisible="True"
                                   HeightRequest="700"
                                    WidthRequest="700"
                                  ItemsSource="{Binding Days}"         
                                  SelectedItem="{Binding SelectedDay, Mode=TwoWay}">
                        <CollectionView.EmptyView>
                            <ContentView>
                                <Border StrokeShape="RoundRectangle 30" 
                                        Stroke="{StaticResource GpsBorder}"
                                        Background="{StaticResource Noon}"
                                        Opacity="1"
                                        StrokeThickness="8">
                                    <Label Text="Please select a date or date range and location."
                                               LineBreakMode="WordWrap"
                                               HorizontalOptions="Center" 
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center"
                                               Margin="5"
                                               FontSize="30"
                                                WidthRequest="350"
                                               FontAttributes="Bold"
                                               FontFamily="NotoThick"/>
                                </Border>
                            </ContentView>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Horizontal" 
                                           HorizontalItemSpacing="20" Span="1" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:DayViewModel">
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="FlipStates">
                                            <VisualState Name="Flipped">
                                                <VisualState.Setters>
                                                    <Setter TargetName="FrontView" Property="VisualElement.RotationY" Value="-180" />
                                                    <Setter TargetName="FrontView" Property="IsVisible" Value="False"/>
                                                    <Setter TargetName="BackView" Property="VisualElement.RotationY" Value="0" />
                                                    <Setter TargetName="BackView" Property="IsVisible" Value="True"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter TargetName="FrontView" Property="VisualElement.RotationY" Value="0" />
                                                    <Setter TargetName="FrontView" Property="IsVisible" Value="True"/>
                                                    <Setter TargetName="BackView"  Property="VisualElement.RotationY" Value="-180" />
                                                    <Setter TargetName="BackView" Property="IsVisible" Value="False"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <!-- Root card border & elevation -->

                                    <!-- Card Tap Gesture-->
                                    <Border x:Name="CardBorder" 
                                            Padding="10"
                                        Background="{Binding DailySkyBrush}"
                                            Style="{StaticResource ActiveLink}" >
                                        <!-- Wraps the Front and Back of Card -->
                                        <Grid x:Name="CardWrapper" 
                                              VerticalOptions="Center"
                                                  HorizontalOptions="Center">
                                            <!--Front of Card-->

                                            <Grid x:Name="FrontView" 
                                                  HorizontalOptions="Center"
                                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"    
                                                  ColumnDefinitions="*,*">
                                                <Label x:Name="CardTitle" 
                                                    Text="{Binding Name}" 
                                                    FontAutoScalingEnabled="True" 
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    FontFamily="NotoThick"
                                                    HorizontalTextAlignment="Center"
                                                    FontSize="32"
                                                    HorizontalOptions="Center"
                                                    TextDecorations="Underline"
                                                    FontAttributes="Bold"/>
                                                <!-- Date -->
                                                <VerticalStackLayout Grid.Row="1"
                                                                     Grid.Column="0" 
                                                                     HorizontalOptions="Center">
                                                    <Label Text="Start Time:" 
                                                           FontFamily="NotoSans" 
                                                           FontAttributes="Bold"/>
                                                    <Label FontAttributes="Bold" 
                                                           FontFamily="NotoThick" 
                                                           Text="{Binding SelectedDailyForecast.StartTime, StringFormat='{}{0:F}'}"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Row="1" 
                                                                     Grid.Column="1" 
                                                                     HorizontalOptions="Center">
                                                    <Label Text=" End Time:" 
                                                           FontFamily="NotoThick" 
                                                           FontAttributes="Bold"/>
                                                    <Label FontAttributes="Bold" 
                                                           FontFamily="NotoThick" 
                                                           Text="{Binding SelectedDailyForecast.EndTime, StringFormat='{}{0:F}'}"/>
                                                </VerticalStackLayout>
                                                <Border x:Name="DailyAnimationBorder"
                                                        Padding="4"
                                                    Grid.Column="0"
                                                    Grid.Row="2"
                                                        Style="{StaticResource ActiveLink}">
                                                    <skia:SKLottieView x:Name="DailyWeatherAnimation" 
                                                                    Source="{Binding SelectedDailyForecast.SkDailyAnimation}"
                                                                    HeightRequest="150"
                                                                        WidthRequest="150"
                                                                        HorizontalOptions="Center"
                                                                        VerticalOptions="Center"
                                                                        RepeatCount="-1" 
                                                                        RepeatMode="Restart"/>
                                                </Border>
                                                <Grid Grid.Row="2" 
                                                          Grid.Column="1" 
                                                          RowSpacing="5"
                                                          RowDefinitions="*,*"
                                                          HorizontalOptions="Center" 
                                                          VerticalOptions="Center">
                                                    <Label Text="{Binding SelectedDailyForecast.TempAndUnit}" 
                                                                   FontFamily="NotoThick" 
                                                                   FontAttributes="Bold" 
                                                                   FontSize="30" 
                                                                   HorizontalOptions="Center"
                                                                   HorizontalTextAlignment="Center"
                                                                   VerticalOptions="Center"
                                                               Grid.Row="0"/>

                                                    <Label Text="{Binding SelectedDailyForecast.ShortForecast}" 
                                                                LineBreakMode="WordWrap"
                                                                HorizontalTextAlignment="Center"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center"
                                                                FontFamily="NotoThick" 
                                                                Grid.Row="1"
                                                                FontAttributes="Bold" 
                                                                FontSize="30" 
                                                                FontAutoScalingEnabled="True"/>
                                                </Grid>

                                                <!--End of row 3 - Daily Image, Temp and description-->

                                                <!--Daily High and Low-->

                                                <Border Stroke="#FF3131" Grid.Row="3" Grid.Column="0" StrokeThickness="4" HorizontalOptions="Fill" VerticalOptions="Fill" Background="{StaticResource RadialRed}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="15,0,15,0" />
                                                    </Border.StrokeShape>
                                                    <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" VerticalOptions="Fill">
                                                        <Grid RowDefinitions="*,*" Grid.Column="0" Margin="8">
                                                            <Label Text="The High Time:" 
                                                                               FontAttributes="Bold" 
                                                                               Grid.Row="0"
                                                                               TextColor="{StaticResource Moon}" 
                                                                               FontFamily="NotoThick" 
                                                                               HorizontalOptions="Start" 
                                                                               HorizontalTextAlignment="Start" 
                                                                               Margin="4"/>




                                                            <Label Text="{Binding DailyHighStatement}" Grid.Row="1" 
                                                                   HorizontalOptions="Start" 
                                                                   HorizontalTextAlignment="Start" 
                                                                   LineBreakMode="WordWrap" 
                                                                   TextColor="{StaticResource Moon}" 
                                                                   Margin="2" 
                                                                   FontFamily="NotoThick" 
                                                                   FontAttributes="Bold"/>
                                                        </Grid>

                                                        <skia:SKLottieView Source="{Binding SkHighAnimation}" 
                                                                               RepeatCount="-1" 
                                                                               HeightRequest="80" 
                                                                               WidthRequest="80" 
                                                                               Grid.Column="1" 
                                                                               RepeatMode="Restart" 
                                                                               HorizontalOptions="Center" 
                                                                               VerticalOptions="Center" 
                                                                               Margin="5"/>
                                                    </Grid>
                                                </Border>


                                                <Border Stroke="Blue" 
                                                            HorizontalOptions="Fill" 
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            VerticalOptions="Fill" 
                                                            StrokeThickness="4" 
                                                            Background="#700000FF">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="0,15,0,15" />
                                                    </Border.StrokeShape>
                                                    <Grid ColumnDefinitions="*,*" 
                                                              HorizontalOptions="Fill" 
                                                              VerticalOptions="Fill">
                                                        <Grid Grid.Column="0" 
                                                                  Margin="8" 
                                                                  RowDefinitions="*,*">
                                                            <Label Text="The Low Time:" 
                                                                                FontAttributes="Bold"
                                                                                TextColor="{StaticResource Moon}" 
                                                                                FontFamily="NotoThick" 
                                                                                HorizontalOptions="Start" 
                                                                                HorizontalTextAlignment="Start" 
                                                                                VerticalOptions="Center"
                                                                                VerticalTextAlignment="Center"
                                                                                Margin="4"
                                                                                Grid.Row="0"/>

                                                            <Label Text="{Binding DailyLowStatement}" 
                                                                               HorizontalOptions="Start" 
                                                                               HorizontalTextAlignment="Start" 
                                                                               LineBreakMode="WordWrap" 
                                                                               VerticalOptions="Center" 
                                                                               VerticalTextAlignment="Center" 
                                                                               TextColor="{StaticResource Moon}" 
                                                                               Margin="2" 
                                                                               FontAttributes="Bold" 
                                                                               FontFamily="NotoThick"
                                                                               Grid.Row="1"/>
                                                        </Grid>
                                                        <skia:SKLottieView Source="{Binding SkLowAnimation}" 
                                                                               HeightRequest="80" 
                                                                               RepeatCount="-1" 
                                                                               Grid.Column="1" 
                                                                               RepeatMode="Restart"  
                                                                               WidthRequest="80" 
                                                                               HorizontalOptions="Center" 
                                                                               VerticalOptions="Center" 
                                                                               Margin="5"/>
                                                    </Grid>
                                                </Border>

                                                <!-- End of Row 4 -->
                                                <!--<CollectionView x:Name="TimeOfDayCollection"
                                                                  ItemsSource="{Binding TimeOfDayForecasts}"
                                                                  ItemSizingStrategy="MeasureAllItems"
                                                                    Grid.Row="4"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                  SelectionMode="None"
                                                                  HorizontalOptions="Fill" >
                                                    <CollectionView.ItemsLayout>
                                                        <LinearItemsLayout Orientation="Vertical"/>
                                                    </CollectionView.ItemsLayout>
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:NwsTimeOfDayForecast">
                                                            <Grid HeightRequest="400" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" Background="{Binding TimeOfDayGradientBrush}">
                                                                <Label  Text="{Binding TimeOfDay}" Grid.Row="0" Grid.Column="0" FontFamily="NotoThick" FontAttributes="Bold" HorizontalOptions="Start" TextColor="{Binding TimeOfDayTextColor}" HorizontalTextAlignment="Start"/>
                                                                <skia:SKLottieView Grid.Row="0" Grid.Column="1" Source="{Binding SKTimeOfDayAnimation}" RepeatCount="-1" RepeatMode="Restart" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Start">
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="Time:"/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="{Binding StartTime, StringFormat='{}h tt}'}"/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text=" - "/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="{Binding EndTime, StringFormat='{}h tt}'}"/>
                                                                </VerticalStackLayout>
                                                                <Label Grid.Row="1" WidthRequest="250" Grid.Column="1" TextColor="{Binding TimeOfDayTextColor}" Text="{Binding TimeOfDayForecast}" FontFamily="NotoSans" HorizontalOptions="Start" HorizontalTextAlignment="Start" LineBreakMode="WordWrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>-->
                                                <!-- Front Footer-->
                                                <Label Grid.Row="4" 
                                                               Grid.Column="0"
                                                              Grid.ColumnSpan="2" 
                                                              Text="Tap for more." 
                                                               HorizontalTextAlignment="Center" 
                                                               HorizontalOptions="Center" 
                                                               FontFamily="NotoThick"
                                                               FontSize="24"
                                                               FontAttributes="Bold"/>

                                            </Grid>



                                            <!-- The Back of the Card-->
                                            <Grid x:Name="BackView" RowDefinitions="Auto,Auto" HorizontalOptions="Center">
                                                <!--Back Header -->

                                                <Label x:Name="BackHeader" 
                                                       Text="Time Of Day Events" 
                                                       FontAttributes="Bold" 
                                                       FontFamily="NotoThick" 
                                                       Grid.Row="0"
                                                       FontSize="24"
                                                       TextDecorations="Underline"
                                                       HorizontalOptions="Center" 
                                                       HorizontalTextAlignment="Center"
                                                       Margin="5"/>

                                                <!-- Back Details -->
                                                <CollectionView x:Name="TimeOfDayCollection"
                   ItemsSource="{Binding TimeOfDayForecasts}"
                   ItemSizingStrategy="MeasureAllItems"
                   SelectionMode="None"
                    Grid.Row="1"
                   HorizontalOptions="Fill" >
                                                    <CollectionView.ItemsLayout>
                                                        <GridItemsLayout Orientation="Horizontal"/>
                                                    </CollectionView.ItemsLayout>
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:NwsTimeOfDayForecast">
                                                            <Grid HeightRequest="400" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10" Background="{Binding TimeOfDayGradientBrush}">
                                                                <Label  Text="{Binding TimeOfDay}" Grid.Row="0" Grid.Column="0" FontFamily="NotoThick" FontAttributes="Bold" HorizontalOptions="Start" TextColor="{Binding TimeOfDayTextColor}" HorizontalTextAlignment="Start"/>
                                                                <skia:SKLottieView Grid.Row="0" Grid.Column="1" Source="{Binding SKTimeOfDayAnimation}" RepeatCount="-1" RepeatMode="Restart" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Start">
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="Time:"/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="{Binding StartTime, StringFormat='{}h tt}'}"/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text=" - "/>
                                                                    <Label TextColor="{Binding TimeOfDayTextColor}" Text="{Binding EndTime, StringFormat='{}h tt}'}"/>
                                                                </VerticalStackLayout>
                                                                <Label Grid.Row="1" WidthRequest="300" Grid.Column="1" TextColor="{Binding TimeOfDayTextColor}" Text="{Binding TimeOfDayForecast}" FontFamily="NotoSans" HorizontalOptions="Start" HorizontalTextAlignment="Start" LineBreakMode="WordWrap"/>
                                                                <CollectionView ItemsSource="{Binding SkLottieCollection}"
                                                                                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                                HeightRequest="400">
                                                                    <CollectionView.ItemsLayout>
                                                                        <GridItemsLayout Span="{Binding SkLottieCollection.Count}" Orientation="Horizontal" />
                                                                    </CollectionView.ItemsLayout>
                                                                    <CollectionView.ItemTemplate>
                                                                        <DataTemplate x:DataType="model:LottieAnimation">
                                                                            <Grid>
                                                                                <Border>
                                                                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                                                                        <Label Text="{Binding TimeString}" Grid.Row="0" HorizontalOptions="Center"/>
                                                                                        <Grid RowDefinitions="*,*" Grid.Row="1" VerticalOptions="Center">
                                                                                            <skia:SKLottieView Grid.Row="0" Source="{Binding LottieWeather}" RepeatCount="-1" RepeatMode="Restart" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                                            <Label Text="{Binding Temperature}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                                        </Grid>
                                                                                        <Label Text="{Binding Forecast}" HorizontalOptions="Center"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </CollectionView.ItemTemplate>
                                                                    
                                                                </CollectionView>
                                                                                
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                                <!--<CollectionView Grid.Row="1" Grid.Column="0" 
                                                                            ItemsSource="{Binding Periods}" 
                                                                            HorizontalOptions="Fill"
                                                                            SelectionMode="None">
                                                        <CollectionView.ItemTemplate>
                                                            <DataTemplate x:DataType="model:DayPeriod">
                                                                <Grid RowSpacing="5">
                                                                    <Border StrokeThickness="4" 
                                                                                    Background="{Binding TimeOfDayBackgroundBrush}" 
                                                                                    Stroke="{StaticResource Moon}">
                                                                        <Border.StrokeShape>
                                                                            <RoundRectangle  CornerRadius="30"/>
                                                                        </Border.StrokeShape>


                                                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                                                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding TimeOfDayName}" FontSize="24" FontFamily="NotoThick" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                                                            <Border x:Name="DailyAnimationBorder"
             Padding="4"
         Grid.Column="1"
         Grid.Row="0"
