    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>
    <Style x:Key="ParallaxSkyStyle" TargetType="Grid">
        <!-- Base sky layout -->
        <Setter Property="Opacity" Value="1" />
        <Setter Property="TranslationX" Value="0" />
        <Setter Property="TranslationY" Value="0" />

        <!-- Visual States -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>

                <!-- Time-of-Day Sky States -->
                <VisualStateGroup x:Name="SkyStates">

                    <!-- EarlyHours -->
                    <VisualState x:Name="EarlyHoursSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodEarlyHours}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TranslationX" Value="0" />
                            <Setter Property="TranslationY" Value="0" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Early Morning -->
                    <VisualState x:Name="EarlyMorningSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodEarlyMorning}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TranslationX" Value="-4" />
                            <Setter Property="TranslationY" Value="2" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Morning -->
                    <VisualState x:Name="MorningSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodMorning}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TranslationX" Value="-6" />
                            <Setter Property="TranslationY" Value="3" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Afternoon -->
                    <VisualState x:Name="AfternoonSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodAfternoon}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TranslationX" Value="-3" />
                            <Setter Property="TranslationY" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Evening -->
                    <VisualState x:Name="EveningSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodEvening}" />
                            <Setter Property="Opacity" Value="0.95" />
                            <Setter Property="TranslationX" Value="2" />
                            <Setter Property="TranslationY" Value="3" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Night -->
                    <VisualState x:Name="NightSky">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{StaticResource PeriodNight}" />
                            <Setter Property="Opacity" Value="0.90" />
                            <Setter Property="TranslationX" Value="4" />
                            <Setter Property="TranslationY" Value="6" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>


                <!-- Scroll-based Parallax Intensity -->
                <VisualStateGroup x:Name="ParallaxIntensityStates">

                    <!-- Normal scroll -->
                    <VisualState x:Name="NormalScroll">
                        <VisualState.Setters>
                            <Setter Property="TranslationX" Value="0" />
                            <Setter Property="TranslationY" Value="0" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Fast scroll (stronger parallax) -->
                    <VisualState x:Name="FastScroll">
                        <VisualState.Setters>
                            <Setter Property="TranslationX" Value="12" />
                            <Setter Property="TranslationY" Value="6" />
                            <Setter Property="Opacity" Value="0.92" />
                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
